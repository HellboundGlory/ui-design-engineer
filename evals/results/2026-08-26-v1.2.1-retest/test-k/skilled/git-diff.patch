@@ -0,0 +1,105 @@
+import { Avatar, Card, Group, Progress, SimpleGrid, Stack, Text, Title } from "@mantine/core";
+import { IconUsers, IconChecklist, IconAlertTriangle, IconBeach } from "@tabler/icons-react";
+import { StatCard } from "../components/StatCard";
+import { StatusBadge } from "../components/StatusBadge";
+import { projects, team } from "../data";
+
+function loadColor(active: number, capacity: number) {
+  if (active === 0) return "slate";
+  if (active > capacity) return "red";
+  if (active === capacity) return "yellow";
+  return "teal";
+}
+
+export function Team() {
+  const roster = team.map((member) => {
+    const assigned = projects.filter((p) => p.lead.name === member.name);
+    const active = assigned.filter((p) => p.status !== "done");
+    const avgProgress = active.length
+      ? Math.round(active.reduce((sum, p) => sum + p.progress, 0) / active.length)
+      : 0;
+    return { member, assigned, active, avgProgress };
+  });
+
+  const overCapacity = roster.filter((r) => r.active.length > r.member.capacity).length;
+  const onBench = roster.filter((r) => r.active.length === 0).length;
+  const avgUtilization = Math.round(
+    (roster.reduce((sum, r) => sum + r.active.length / r.member.capacity, 0) / roster.length) * 100,
+  );
+
+  return (
+    <Stack gap="xl">
+      <div>
+        <Title order={1}>Team</Title>
+        <Text c="dimmed" size="sm" mt={4}>
+          Staffing and workload across the studio.
+        </Text>
+      </div>
+
+      <SimpleGrid cols={{ base: 1, sm: 2, lg: 4 }}>
+        <StatCard label="Team members" value={String(team.length)} icon={IconUsers} />
+        <StatCard label="Avg. utilization" value={`${avgUtilization}%`} icon={IconChecklist} />
+        <StatCard
+          label="Over capacity"
+          value={String(overCapacity)}
+          delta={overCapacity > 0 ? `${overCapacity} need rebalancing` : undefined}
+          deltaPositive={false}
+          icon={IconAlertTriangle}
+        />
+        <StatCard label="On the bench" value={String(onBench)} icon={IconBeach} />
+      </SimpleGrid>
+
+      <SimpleGrid cols={{ base: 1, sm: 2, lg: 3 }}>
+        {roster.map(({ member, assigned, active, avgProgress }) => (
+          <Card key={member.id} padding="lg">
+            <Group gap="sm" align="flex-start" wrap="nowrap">
+              <Avatar size="md" radius="xl" color="meridian">
+                {member.initials}
+              </Avatar>
+              <div style={{ flex: 1, minWidth: 0 }}>
+                <Text size="sm" fw={600}>
+                  {member.name}
+                </Text>
+                <Text size="xs" c="dimmed">
+                  {member.role}
+                </Text>
+              </div>
+            </Group>
+
+            <Group justify="space-between" mt="md" mb={4}>
+              <Text size="xs" c="dimmed">
+                {active.length} of {member.capacity} project{member.capacity === 1 ? "" : "s"}
+              </Text>
+              {active.length > 0 && (
+                <Text size="xs" c="dimmed">
+                  {avgProgress}% avg
+                </Text>
+              )}
+            </Group>
+            <Progress
+              value={(active.length / member.capacity) * 100}
+              size="sm"
+              color={loadColor(active.length, member.capacity)}
+            />
+
+            <Stack gap={6} mt="md">
+              {assigned.length === 0 && (
+                <Text size="xs" c="dimmed">
+                  No projects assigned.
+                </Text>
+              )}
+              {assigned.map((p) => (
+                <Group key={p.id} justify="space-between" wrap="nowrap">
+                  <Text size="xs" truncate style={{ flex: 1 }}>
+                    {p.name}
+                  </Text>
+                  <StatusBadge status={p.status} />
+                </Group>
+              ))}
+            </Stack>
+          </Card>
+        ))}
+      </SimpleGrid>
+    </Stack>
+  );
+}
