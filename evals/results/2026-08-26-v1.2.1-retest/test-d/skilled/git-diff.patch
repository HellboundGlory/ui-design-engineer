+import * as React from 'react'
+
+import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card'
+import { Meter } from '@/components/ui/meter'
+import { useToast } from '@/components/ui/toast'
+import { ChangePlanDialog } from '@/features/billing/change-plan-dialog'
+import { InvoiceTable } from '@/features/billing/invoice-table'
+import { PaymentMethodCard } from '@/features/billing/payment-method-card'
+import { PlanCards } from '@/features/billing/plan-cards'
+import { currentPlanId as initialPlanId, invoices, plans, usage } from '@/lib/mock-data'
+import type { Plan, PlanId } from '@/lib/types'
+import { formatDate } from '@/lib/utils'
+
+export function BillingPage() {
+  const { toast } = useToast()
+  const [currentPlanId, setCurrentPlanId] = React.useState<PlanId>(initialPlanId)
+  const [target, setTarget] = React.useState<{ plan: Plan; direction: 'upgrade' | 'downgrade' } | null>(null)
+
+  const currentPlan = plans.find((p) => p.id === currentPlanId)!
+
+  function confirmChange(planId: PlanId) {
+    setCurrentPlanId(planId)
+    const plan = plans.find((p) => p.id === planId)!
+    setTarget(null)
+    toast({
+      title: `You're now on ${plan.name}`,
+      description: 'Your next invoice will reflect the new plan.',
+      variant: 'success',
+    })
+  }
+
+  return (
+    <div className="flex min-w-0 flex-col gap-8">
+      <Card>
+        <CardHeader>
+          <CardTitle>Current usage</CardTitle>
+          <CardDescription>
+            {currentPlan.name} plan · resets {formatDate(usage.periodEndIso)}
+          </CardDescription>
+        </CardHeader>
+        <CardContent className="grid gap-5 sm:grid-cols-2">
+          <Meter
+            label="Seats"
+            value={usage.seatsUsed}
+            max={currentPlan.seatLimit}
+            valueLabel={`${usage.seatsUsed} / ${currentPlan.seatLimit}`}
+          />
+          <Meter
+            label="API requests this period"
+            value={usage.apiRequestsUsed}
+            max={usage.apiRequestsLimit}
+            valueLabel={`${usage.apiRequestsUsed.toLocaleString()} / ${usage.apiRequestsLimit.toLocaleString()}`}
+          />
+        </CardContent>
+      </Card>
+
+      <div>
+        <h2 className="mb-3 text-sm font-semibold text-foreground">Plans</h2>
+        <PlanCards
+          plans={plans}
+          currentPlanId={currentPlanId}
+          onSelect={(plan, direction) => setTarget({ plan, direction })}
+        />
+      </div>
+
+      <PaymentMethodCard />
+
+      <InvoiceTable invoices={invoices} />
+
+      <ChangePlanDialog
+        targetPlan={target?.plan ?? null}
+        direction={target?.direction ?? null}
+        onOpenChange={(open) => !open && setTarget(null)}
+        onConfirm={confirmChange}
+      />
+    </div>
+  )
+}
