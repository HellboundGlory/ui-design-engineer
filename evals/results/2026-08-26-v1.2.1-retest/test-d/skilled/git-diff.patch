+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import type { Plan } from '@/lib/types'
+import { formatCurrency } from '@/lib/utils'
+
+interface ChangePlanDialogProps {
+  targetPlan: Plan | null
+  direction: 'upgrade' | 'downgrade' | null
+  onOpenChange: (open: boolean) => void
+  onConfirm: (planId: Plan['id']) => void
+}
+
+export function ChangePlanDialog({ targetPlan, direction, onOpenChange, onConfirm }: ChangePlanDialogProps) {
+  return (
+    <Dialog open={!!targetPlan} onOpenChange={onOpenChange}>
