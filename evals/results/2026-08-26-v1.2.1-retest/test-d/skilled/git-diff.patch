+import * as React from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+  DialogTrigger,
+} from '@/components/ui/dialog'
+import { Input } from '@/components/ui/input'
+import { Label } from '@/components/ui/label'
+import { useToast } from '@/components/ui/toast'
+import { currentUser } from '@/lib/mock-data'
+
+export function DangerZone() {
+  const { toast } = useToast()
+  const [open, setOpen] = React.useState(false)
+  const [confirmText, setConfirmText] = React.useState('')
+
+  function onConfirmDelete() {
+    setOpen(false)
+    setConfirmText('')
+    toast({
+      title: 'Account deletion requested',
+      description: 'We emailed you a confirmation link — no changes have been made yet.',
+    })
+  }
+
+  return (
+    <Card className="border-status-error/30">
+      <CardHeader>
+        <CardTitle>Danger zone</CardTitle>
+        <CardDescription>Permanently delete your account and all associated data.</CardDescription>
+      </CardHeader>
+      <CardContent className="flex items-center justify-between gap-4">
+        <p className="text-sm text-muted-foreground">
+          This deactivates your login and removes you from every workspace you belong to. Workspaces
+          you own will need a new owner first.
+        </p>
+        <Dialog open={open} onOpenChange={setOpen}>
+          <DialogTrigger asChild>
+            <Button variant="destructive" size="sm" className="shrink-0">
+              Delete account
+            </Button>
+          </DialogTrigger>
+          <DialogContent>
+            <DialogHeader>
+              <DialogTitle>Delete your account?</DialogTitle>
+              <DialogDescription>
+                This can&apos;t be undone. Type <span className="font-mono font-medium text-foreground">{currentUser.email}</span> to
+                confirm.
+              </DialogDescription>
+            </DialogHeader>
+            <div className="flex flex-col gap-1.5">
+              <Label htmlFor="confirm-delete" className="sr-only">
+                Confirm your email address
+              </Label>
+              <Input
+                id="confirm-delete"
+                value={confirmText}
+                onChange={(e) => setConfirmText(e.target.value)}
+                placeholder={currentUser.email}
+                autoComplete="off"
+              />
+            </div>
+            <DialogFooter>
+              <Button variant="secondary" onClick={() => setOpen(false)}>
+                Cancel
+              </Button>
+              <Button
+                variant="destructive"
+                disabled={confirmText !== currentUser.email}
+                onClick={onConfirmDelete}
+              >
+                Delete my account
+              </Button>
+            </DialogFooter>
+          </DialogContent>
+        </Dialog>
+      </CardContent>
+    </Card>
+  )
+}
