@@ -0,0 +1,168 @@
+import { KeyRound, MoreHorizontal, Plus } from 'lucide-react'
+import * as React from 'react'
+
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card'
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuTrigger,
+} from '@/components/ui/dropdown-menu'
+import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
+import { useToast } from '@/components/ui/toast'
+import { CreateKeyDialog } from '@/features/api-keys/create-key-dialog'
+import { RevealSecretDialog } from '@/features/api-keys/reveal-secret-dialog'
+import { RevokeKeyDialog } from '@/features/api-keys/revoke-key-dialog'
+import { currentUser, generateApiSecret, initialApiKeys } from '@/lib/mock-data'
+import type { ApiKey, ApiScope } from '@/lib/types'
+import { formatDate, formatRelativeToNow } from '@/lib/utils'
+
+const SCOPE_LABEL: Record<ApiScope, string> = {
+  read: 'Read',
+  write: 'Write',
+  billing: 'Billing',
+  admin: 'Admin',
+}
+
+export function ApiKeysPage() {
+  const { toast } = useToast()
+  const [keys, setKeys] = React.useState<ApiKey[]>(initialApiKeys)
+  const [createOpen, setCreateOpen] = React.useState(false)
+  const [pendingReveal, setPendingReveal] = React.useState<{ secret: string; name: string } | null>(null)
+  const [revokeTarget, setRevokeTarget] = React.useState<ApiKey | null>(null)
+
+  function handleCreate(name: string, scopes: ApiScope[]) {
+    const secretBody = generateApiSecret()
+    const prefix = scopes.includes('admin') || scopes.includes('write') ? 'sk_live_' : 'sk_test_'
+    const newKey: ApiKey = {
+      id: `key_${crypto.randomUUID().slice(0, 8)}`,
+      name,
+      prefix,
+      lastFour: secretBody.slice(-4),
+      scopes,
+      createdIso: new Date().toISOString(),
+      lastUsedIso: null,
+      createdBy: currentUser.name,
+      status: 'active',
+    }
+    setKeys((prev) => [newKey, ...prev])
+    setCreateOpen(false)
+    setPendingReveal({ secret: `${prefix}${secretBody}`, name })
+  }
+
+  function handleRevoke(id: string) {
+    setKeys((prev) => prev.map((k) => (k.id === id ? { ...k, status: 'revoked' } : k)))
+    setRevokeTarget(null)
+    toast({ title: 'Key revoked', description: 'Any application using this key has lost access.' })
+  }
+
+  const activeCount = keys.filter((k) => k.status === 'active').length
+
+  return (
+    <div className="flex min-w-0 flex-col gap-6">
+      <Card>
+        <CardHeader className="flex-row items-center justify-between space-y-0">
+          <div>
+            <CardTitle>API keys</CardTitle>
+            <CardDescription>
+              {activeCount} active key{activeCount === 1 ? '' : 's'} · secrets are shown once, at creation
+            </CardDescription>
+          </div>
+          <Button size="sm" onClick={() => setCreateOpen(true)}>
+            <Plus />
+            Create key
+          </Button>
+        </CardHeader>
+        <CardContent className="p-0">
+          {keys.length === 0 ? (
+            <div className="flex flex-col items-center gap-2 px-6 py-16 text-center">
+              <KeyRound className="size-8 text-muted-foreground" aria-hidden="true" />
+              <p className="text-sm font-medium text-foreground">No API keys yet</p>
+              <p className="text-sm text-muted-foreground">Create one to start calling the Acme API.</p>
+            </div>
+          ) : (
+            <Table>
+              <TableHeader>
+                <TableRow>
+                  <TableHead className="pl-6">Name</TableHead>
+                  <TableHead>Key</TableHead>
+                  <TableHead>Permissions</TableHead>
+                  <TableHead>Created</TableHead>
+                  <TableHead>Last used</TableHead>
+                  <TableHead className="pr-6 text-right">
+                    <span className="sr-only">Actions</span>
+                  </TableHead>
+                </TableRow>
+              </TableHeader>
+              <TableBody>
+                {keys.map((key) => (
+                  <TableRow key={key.id}>
+                    <TableCell className="pl-6">
+                      <div className="flex flex-col">
+                        <span className="font-medium">{key.name}</span>
+                        <span className="text-xs text-muted-foreground">by {key.createdBy}</span>
+                      </div>
+                    </TableCell>
+                    <TableCell>
+                      <div className="flex items-center gap-2">
+                        <code className="tabular-nums font-mono text-xs text-muted-foreground">
+                          {key.prefix}••••••••{key.lastFour}
+                        </code>
+                        {key.status === 'revoked' && <Badge variant="error">Revoked</Badge>}
+                      </div>
+                    </TableCell>
+                    <TableCell>
+                      <div className="flex flex-wrap gap-1">
+                        {key.scopes.map((s) => (
+                          <Badge key={s} variant="outline">
+                            {SCOPE_LABEL[s]}
+                          </Badge>
+                        ))}
+                      </div>
+                    </TableCell>
+                    <TableCell className="tabular-nums text-muted-foreground">
+                      {formatDate(key.createdIso)}
+                    </TableCell>
+                    <TableCell className="tabular-nums text-muted-foreground">
+                      {key.lastUsedIso ? formatRelativeToNow(key.lastUsedIso) : 'Never'}
+                    </TableCell>
+                    <TableCell className="pr-6 text-right">
+                      {key.status === 'active' && (
+                        <DropdownMenu>
+                          <DropdownMenuTrigger asChild>
+                            <Button variant="ghost" size="icon-sm" aria-label={`Actions for ${key.name}`}>
+                              <MoreHorizontal />
+                            </Button>
+                          </DropdownMenuTrigger>
+                          <DropdownMenuContent align="end">
+                            <DropdownMenuItem destructive onSelect={() => setRevokeTarget(key)}>
+                              Revoke key
+                            </DropdownMenuItem>
+                          </DropdownMenuContent>
+                        </DropdownMenu>
+                      )}
+                    </TableCell>
+                  </TableRow>
+                ))}
+              </TableBody>
+            </Table>
+          )}
+        </CardContent>
+      </Card>
+
+      <CreateKeyDialog open={createOpen} onOpenChange={setCreateOpen} onCreate={handleCreate} />
+      <RevealSecretDialog
+        secret={pendingReveal?.secret ?? null}
+        keyName={pendingReveal?.name ?? null}
+        onClose={() => setPendingReveal(null)}
+      />
+      <RevokeKeyDialog
+        apiKey={revokeTarget}
+        onOpenChange={(open) => !open && setRevokeTarget(null)}
+        onConfirm={handleRevoke}
+      />
+    </div>
+  )
+}
diff --git a/src/features/api-keys/create-key-dialog.tsx b/src/features/api-keys/create-key-dialog.tsx
new file mode 100644
index 0000000..354fa48
--- /dev/null
+++ b/src/features/api-keys/create-key-dialog.tsx
@@ -0,0 +1,127 @@
+import * as React from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Checkbox } from '@/components/ui/checkbox'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import { Input } from '@/components/ui/input'
+import { Label } from '@/components/ui/label'
+import type { ApiScope } from '@/lib/types'
+
+const SCOPE_OPTIONS: { value: ApiScope; label: string; description: string }[] = [
+  { value: 'read', label: 'Read', description: 'List and fetch resources.' },
+  { value: 'write', label: 'Write', description: 'Create, update, and delete resources.' },
+  { value: 'billing', label: 'Billing', description: 'View invoices and subscription details.' },
+  { value: 'admin', label: 'Admin', description: 'Manage team members and workspace settings.' },
+]
+
+interface CreateKeyDialogProps {
+  open: boolean
+  onOpenChange: (open: boolean) => void
+  onCreate: (name: string, scopes: ApiScope[]) => void
+}
+
+export function CreateKeyDialog({ open, onOpenChange, onCreate }: CreateKeyDialogProps) {
+  const [name, setName] = React.useState('')
+  const [scopes, setScopes] = React.useState<ApiScope[]>(['read'])
+  const [touched, setTouched] = React.useState(false)
+
+  const nameError = touched && name.trim().length < 2 ? 'Give this key a name so you can recognize it later.' : null
+
+  function toggleScope(scope: ApiScope, checked: boolean) {
+    setScopes((prev) => (checked ? [...prev, scope] : prev.filter((s) => s !== scope)))
+  }
+
+  function reset() {
+    setName('')
+    setScopes(['read'])
+    setTouched(false)
+  }
+
+  function handleSubmit(e: React.FormEvent) {
+    e.preventDefault()
+    setTouched(true)
+    if (name.trim().length < 2 || scopes.length === 0) return
+    onCreate(name.trim(), scopes)
+    reset()
+  }
+
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={(next) => {
+        onOpenChange(next)
+        if (!next) reset()
+      }}
+    >
+      <DialogContent>
+        <form onSubmit={handleSubmit} noValidate>
+          <DialogHeader>
+            <DialogTitle>Create API key</DialogTitle>
+            <DialogDescription>
+              Scope this key to only what it needs. You&apos;ll see the full secret once, right after
+              creation.
+            </DialogDescription>
+          </DialogHeader>
+
+          <div className="flex flex-col gap-5">
+            <div className="flex flex-col gap-1.5">
+              <Label htmlFor="key-name">Key name</Label>
+              <Input
+                id="key-name"
+                placeholder="e.g. Production backend"
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+                invalid={!!nameError}
+                autoFocus
+              />
+              {nameError && (
+                <p className="text-xs text-status-error" role="alert">
+                  {nameError}
+                </p>
+              )}
+            </div>
+
+            <fieldset className="flex flex-col gap-3">
+              <legend className="text-sm font-medium text-foreground">Permissions</legend>
+              {SCOPE_OPTIONS.map((opt) => (
+                <label
+                  key={opt.value}
+                  className="flex cursor-pointer items-start gap-3 rounded-[var(--radius-md)] border border-border p-3 transition-colors hover:bg-muted/40 has-[:checked]:border-primary/40 has-[:checked]:bg-accent/40"
+                >
+                  <Checkbox
+                    checked={scopes.includes(opt.value)}
+                    onCheckedChange={(checked) => toggleScope(opt.value, checked === true)}
+                    className="mt-0.5"
+                  />
+                  <span>
+                    <span className="block text-sm font-medium text-foreground">{opt.label}</span>
+                    <span className="block text-xs text-muted-foreground">{opt.description}</span>
+                  </span>
+                </label>
+              ))}
+              {touched && scopes.length === 0 && (
+                <p className="text-xs text-status-error" role="alert">
+                  Select at least one permission.
+                </p>
+              )}
+            </fieldset>
+          </div>
+
+          <DialogFooter>
+            <Button type="button" variant="secondary" onClick={() => onOpenChange(false)}>
+              Cancel
+            </Button>
+            <Button type="submit">Create key</Button>
+          </DialogFooter>
+        </form>
+      </DialogContent>
+    </Dialog>
+  )
+}
diff --git a/src/features/api-keys/reveal-secret-dialog.tsx b/src/features/api-keys/reveal-secret-dialog.tsx
new file mode 100644
index 0000000..340efeb
--- /dev/null
+++ b/src/features/api-keys/reveal-secret-dialog.tsx
@@ -0,0 +1,80 @@
+import { AlertTriangle, Check, Copy } from 'lucide-react'
+import * as React from 'react'
+
+import { Button } from '@/components/ui/button'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import { useToast } from '@/components/ui/toast'
+
+interface RevealSecretDialogProps {
+  secret: string | null
+  keyName: string | null
+  onClose: () => void
+}
+
+export function RevealSecretDialog({ secret, keyName, onClose }: RevealSecretDialogProps) {
+  const { toast } = useToast()
+  const [copied, setCopied] = React.useState(false)
+
+  function handleClose() {
+    setCopied(false)
+    onClose()
+  }
+
+  async function copySecret() {
+    if (!secret) return
+    try {
+      await navigator.clipboard.writeText(secret)
+      setCopied(true)
+      toast({ title: 'Copied to clipboard' })
+    } catch {
+      toast({ title: 'Copy failed', description: 'Select the key text and copy it manually.' })
+    }
+  }
+
+  return (
+    <Dialog open={!!secret} onOpenChange={(next) => !next && handleClose()}>
+      <DialogContent hideClose>
+        <DialogHeader>
+          <DialogTitle>{keyName}</DialogTitle>
+          <DialogDescription>Copy this key now — you won&apos;t be able to see it again.</DialogDescription>
+        </DialogHeader>
+
+        <div className="flex items-center justify-between gap-3 rounded-[var(--radius-md)] border border-border bg-muted/50 px-3 py-2.5">
+          <code className="flex-1 overflow-x-auto whitespace-nowrap font-mono text-sm text-foreground">
+            {secret}
+          </code>
+          <Button
+            type="button"
+            variant="secondary"
+            size="icon-sm"
+            onClick={copySecret}
+            aria-label="Copy API key"
+          >
+            {copied ? <Check className="text-status-success" /> : <Copy />}
+          </Button>
+        </div>
+
+        <div className="mt-4 flex items-start gap-2.5 rounded-[var(--radius-md)] border border-status-warning/25 bg-status-warning/10 p-3">
+          <AlertTriangle className="mt-0.5 size-4 shrink-0 text-status-warning" aria-hidden="true" />
+          <p className="text-xs text-foreground">
+            For security, we don&apos;t store this key. If you lose it, you&apos;ll need to revoke this
+            one and create a new key.
+          </p>
+        </div>
+
+        <DialogFooter>
+          <Button type="button" onClick={handleClose}>
+            Done, I&apos;ve saved it
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  )
+}
