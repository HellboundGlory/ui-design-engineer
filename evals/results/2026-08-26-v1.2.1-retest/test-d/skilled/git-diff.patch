@@ -0,0 +1,68 @@
+import { Check } from 'lucide-react'
+
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { cn, formatCurrency } from '@/lib/utils'
+import type { Plan, PlanId } from '@/lib/types'
+
+interface PlanCardsProps {
+  plans: Plan[]
+  currentPlanId: PlanId
+  onSelect: (plan: Plan, direction: 'upgrade' | 'downgrade') => void
+}
+
+const ORDER: PlanId[] = ['starter', 'growth', 'enterprise']
+
+export function PlanCards({ plans, currentPlanId, onSelect }: PlanCardsProps) {
+  const currentIndex = ORDER.indexOf(currentPlanId)
+
+  return (
+    <div className="grid gap-4 sm:grid-cols-3">
+      {plans.map((plan) => {
+        const isCurrent = plan.id === currentPlanId
+        const index = ORDER.indexOf(plan.id)
+        const direction: 'upgrade' | 'downgrade' = index > currentIndex ? 'upgrade' : 'downgrade'
+
+        return (
+          <div
+            key={plan.id}
+            className={cn(
+              'flex flex-col rounded-[var(--radius-lg)] border p-5',
+              isCurrent ? 'border-primary/50 bg-accent/30' : 'border-border bg-card',
+            )}
+          >
+            <div className="flex items-center justify-between gap-2">
+              <h3 className="text-sm font-semibold text-foreground">{plan.name}</h3>
+              {isCurrent && <Badge variant="info">Current plan</Badge>}
+            </div>
+            <p className="mt-1 text-xs text-muted-foreground">{plan.description}</p>
+            <p className="mt-4 flex items-baseline gap-1">
+              <span className="text-2xl font-semibold tabular-nums text-foreground">
+                {plan.priceCents === 0 ? 'Free' : formatCurrency(plan.priceCents)}
+              </span>
+              {plan.priceCents > 0 && <span className="text-sm text-muted-foreground">/month</span>}
+            </p>
+
+            <ul className="mt-5 flex flex-1 flex-col gap-2.5">
+              {plan.features.map((f) => (
+                <li key={f} className="flex items-start gap-2 text-sm text-foreground">
+                  <Check className="mt-0.5 size-4 shrink-0 text-status-success" aria-hidden="true" />
+                  {f}
+                </li>
+              ))}
+            </ul>
+
+            <Button
+              variant={isCurrent ? 'secondary' : direction === 'upgrade' ? 'primary' : 'secondary'}
+              className="mt-6"
+              disabled={isCurrent}
+              onClick={() => onSelect(plan, direction)}
+            >
+              {isCurrent ? 'Current plan' : direction === 'upgrade' ? 'Upgrade' : 'Downgrade'}
+            </Button>
+          </div>
+        )
+      })}
+    </div>
+  )
+}
diff --git a/src/features/team/invite-dialog.tsx b/src/features/team/invite-dialog.tsx
new file mode 100644
index 0000000..9e1f8a3
--- /dev/null
+++ b/src/features/team/invite-dialog.tsx
@@ -0,0 +1,188 @@
+import { X } from 'lucide-react'
+import * as React from 'react'
+
+import { Button } from '@/components/ui/button'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import { Label } from '@/components/ui/label'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+import { ASSIGNABLE_ROLES, ROLE_LABEL } from '@/lib/roles'
+import type { Role } from '@/lib/types'
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
+
+interface InviteDialogProps {
+  open: boolean
+  onOpenChange: (open: boolean) => void
+  existingEmails: string[]
+  onInvite: (emails: string[], role: Role) => void
+}
+
+export function InviteDialog({ open, onOpenChange, existingEmails, onInvite }: InviteDialogProps) {
+  const [pendingEmails, setPendingEmails] = React.useState<string[]>([])
+  const [draft, setDraft] = React.useState('')
+  const [role, setRole] = React.useState<Role>('member')
+  const [error, setError] = React.useState<string | null>(null)
+
+  function reset() {
+    setPendingEmails([])
+    setDraft('')
+    setRole('member')
+    setError(null)
+  }
+
+  function commitDraft(): boolean {
+    const value = draft.trim().toLowerCase()
+    if (!value) return true
+    if (!EMAIL_RE.test(value)) {
+      setError(`"${value}" isn't a valid email address.`)
+      return false
+    }
+    if (existingEmails.includes(value) || pendingEmails.includes(value)) {
+      setError(`${value} is already on this team.`)
+      return false
+    }
+    setPendingEmails((prev) => [...prev, value])
+    setDraft('')
+    setError(null)
+    return true
+  }
+
+  /** Validates the in-progress draft and returns the full email list synchronously,
+   *  since setState from commitDraft() wouldn't be visible until the next render. */
+  function resolveEmailsForSubmit(): string[] | null {
+    const value = draft.trim().toLowerCase()
+    if (!value) return pendingEmails
+    if (!EMAIL_RE.test(value)) {
+      setError(`"${value}" isn't a valid email address.`)
+      return null
+    }
+    if (existingEmails.includes(value) || pendingEmails.includes(value)) {
+      setError(`${value} is already on this team.`)
+      return null
+    }
+    return [...pendingEmails, value]
+  }
+
+  function handleKeyDown(e: React.KeyboardEvent<HTMLInputElement>) {
+    if (e.key === 'Enter' || e.key === ',') {
+      e.preventDefault()
+      commitDraft()
+    } else if (e.key === 'Backspace' && draft === '' && pendingEmails.length > 0) {
+      setPendingEmails((prev) => prev.slice(0, -1))
+    }
+  }
+
+  function removeEmail(email: string) {
+    setPendingEmails((prev) => prev.filter((e) => e !== email))
+  }
+
+  function handleSubmit(e: React.FormEvent) {
+    e.preventDefault()
+    const emails = resolveEmailsForSubmit()
+    if (emails === null) return
+    if (emails.length === 0) {
+      setError('Add at least one email address.')
+      return
+    }
+    onInvite(emails, role)
+    reset()
+  }
+
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={(next) => {
+        onOpenChange(next)
+        if (!next) reset()
+      }}
+    >
+      <DialogContent>
+        <form onSubmit={handleSubmit} noValidate>
+          <DialogHeader>
+            <DialogTitle>Invite teammates</DialogTitle>
+            <DialogDescription>They&apos;ll get an email with a link to join this workspace.</DialogDescription>
+          </DialogHeader>
+
+          <div className="flex flex-col gap-5">
+            <div className="flex flex-col gap-1.5">
+              <Label htmlFor="invite-emails">Email addresses</Label>
+              <div
+                className="flex min-h-10 flex-wrap items-center gap-1.5 rounded-[var(--radius-md)] border border-border bg-card px-2 py-1.5 focus-within:ring-2 focus-within:ring-ring focus-within:border-ring"
+                onClick={() => document.getElementById('invite-emails')?.focus()}
+              >
+                {pendingEmails.map((email) => (
+                  <span
+                    key={email}
+                    className="flex items-center gap-1 rounded-full bg-muted py-1 pl-2.5 pr-1 text-xs text-foreground"
+                  >
+                    {email}
+                    <button
+                      type="button"
+                      onClick={() => removeEmail(email)}
+                      className="rounded-full p-0.5 text-muted-foreground hover:bg-border hover:text-foreground"
+                      aria-label={`Remove ${email}`}
+                    >
+                      <X className="size-3" />
+                    </button>
+                  </span>
+                ))}
+                <input
+                  id="invite-emails"
+                  type="text"
+                  value={draft}
+                  onChange={(e) => {
+                    setDraft(e.target.value)
+                    setError(null)
+                  }}
+                  onKeyDown={handleKeyDown}
+                  onBlur={commitDraft}
+                  placeholder={pendingEmails.length === 0 ? 'name@company.com' : ''}
+                  className="min-w-[8rem] flex-1 bg-transparent py-1 text-sm text-foreground outline-none placeholder:text-muted-foreground"
+                  aria-describedby={error ? 'invite-emails-error' : undefined}
+                />
+              </div>
+              <p className="text-xs text-muted-foreground">Press Enter or comma to add each address.</p>
+              {error && (
+                <p id="invite-emails-error" className="text-xs text-status-error" role="alert">
+                  {error}
+                </p>
+              )}
+            </div>
+
+            <div className="flex flex-col gap-1.5">
+              <Label htmlFor="invite-role">Role</Label>
+              <Select value={role} onValueChange={(v) => setRole(v as Role)}>
+                <SelectTrigger id="invite-role">
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  {ASSIGNABLE_ROLES.map((r) => (
+                    <SelectItem key={r} value={r}>
+                      {ROLE_LABEL[r]}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            </div>
+          </div>
+
+          <DialogFooter>
+            <Button type="button" variant="secondary" onClick={() => onOpenChange(false)}>
+              Cancel
+            </Button>
+            <Button type="submit">
+              Send invite{pendingEmails.length > 1 ? 's' : ''}
+            </Button>
+          </DialogFooter>
+        </form>
+      </DialogContent>
+    </Dialog>
+  )
+}
