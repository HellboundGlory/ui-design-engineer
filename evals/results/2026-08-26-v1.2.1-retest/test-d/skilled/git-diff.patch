+
+const SECTIONS = [
+  { to: '/account', label: 'Account Profile', icon: UserCircle },
+  { to: '/api-keys', label: 'API Keys', icon: KeyRound },
+  { to: '/billing', label: 'Billing Plan', icon: Receipt },
+  { to: '/team', label: 'Team Permissions', icon: Users },
+]
+
+export function SettingsNav() {
+  return (
+    <nav aria-label="Settings sections" className="border-b border-border">
+      <ul className="flex list-none gap-1 overflow-x-auto">
+        {SECTIONS.map(({ to, label, icon: Icon }) => (
+          <li key={to} className="shrink-0">
+            <NavLink
+              to={to}
+              className={({ isActive }) =>
+                cn(
+                  'relative flex items-center gap-2 whitespace-nowrap px-3.5 py-3 text-sm font-medium text-muted-foreground transition-colors',
