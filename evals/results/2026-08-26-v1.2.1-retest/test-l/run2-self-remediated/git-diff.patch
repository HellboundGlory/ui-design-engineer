new file mode 100644
index 0000000..e231628
--- /dev/null
+++ b/src/components/MetricStrip.tsx
@@ -0,0 +1,73 @@
+import clsx from 'clsx'
+import { formatMs, formatPct, formatRps } from '../lib/metrics'
+
+interface Metric {
+  label: string
+  value: string
+  delta?: number
+  deltaLabel?: string
+  tone?: 'neutral' | 'good' | 'bad'
+}
+
+function Delta({ delta, tone }: { delta: number; tone: 'neutral' | 'good' | 'bad' }) {
+  if (!Number.isFinite(delta) || Math.abs(delta) < 0.05) {
+    return <span className="text-xs text-muted-foreground">flat</span>
+  }
+  const up = delta > 0
+  const color = tone === 'neutral' ? 'text-muted-foreground' : tone === 'good' ? 'text-status-success' : 'text-status-error'
+  return (
+    <span className={clsx('text-xs tabular-nums', color)}>
+      {up ? '↑' : '↓'} {Math.abs(delta).toFixed(1)}%
+    </span>
+  )
+}
+
+export function MetricStrip({
+  rps,
+  errorRatePct,
+  p95,
+  p99,
+  activeEndpoints,
+  openIncidents,
+  rpsDelta,
+  errorDelta,
+}: {
+  rps: number
+  errorRatePct: number
+  p95: number
+  p99: number
+  activeEndpoints: number
+  openIncidents: number
+  rpsDelta: number
+  errorDelta: number
+}) {
+  const metrics: Metric[] = [
+    { label: 'Throughput', value: `${formatRps(rps)} req/s`, delta: rpsDelta, tone: 'neutral' },
+    { label: 'Error rate', value: formatPct(errorRatePct), delta: errorDelta, tone: 'bad' },
+    { label: 'p95 latency', value: formatMs(p95) },
+    { label: 'p99 latency', value: formatMs(p99) },
+    { label: 'Active endpoints', value: String(activeEndpoints) },
+    { label: 'Open incidents', value: String(openIncidents), tone: openIncidents > 0 ? 'bad' : 'neutral' },
+  ]
+
+  return (
+    <div className="flex flex-wrap divide-x divide-border rounded-md border border-border bg-surface">
+      {metrics.map((metric) => (
+        <div key={metric.label} className="flex min-w-[9.5rem] flex-1 flex-col gap-1 px-4 py-3">
+          <span className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">{metric.label}</span>
+          <div className="flex items-baseline gap-2">
+            <span
+              className={clsx(
+                'text-xl font-semibold tabular-nums',
+                metric.label === 'Open incidents' && metric.tone === 'bad' ? 'text-status-error' : 'text-foreground',
+              )}
+            >
+              {metric.value}
+            </span>
+            {metric.delta !== undefined && <Delta delta={metric.delta} tone={metric.tone ?? 'neutral'} />}
+          </div>
+        </div>
+      ))}
+    </div>
+  )
+}
