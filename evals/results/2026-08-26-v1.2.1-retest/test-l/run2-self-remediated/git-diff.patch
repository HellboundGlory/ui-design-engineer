+++ b/src/components/EndpointsTable.tsx
@@ -0,0 +1,134 @@
+import { useMemo, useState } from 'react'
+import clsx from 'clsx'
+import { StatusBadge } from './StatusBadge'
+import { formatMs, formatPct, formatRps } from '../lib/metrics'
+import type { EndpointRow } from '../types'
+
+type SortKey = 'path' | 'rps' | 'errorRatePct' | 'p95' | 'p99' | 'status'
+type SortDir = 'asc' | 'desc'
+
+const STATUS_RANK = { critical: 0, warning: 1, healthy: 2 }
+
+const COLUMNS: { key: SortKey; label: string; align: 'left' | 'right' }[] = [
+  { key: 'path', label: 'Endpoint', align: 'left' },
+  { key: 'rps', label: 'req/s', align: 'right' },
+  { key: 'errorRatePct', label: 'Error rate', align: 'right' },
+  { key: 'p95', label: 'p95', align: 'right' },
+  { key: 'p99', label: 'p99', align: 'right' },
+  { key: 'status', label: 'Status', align: 'left' },
+]
+
+const METHOD_COLOR: Record<string, string> = {
+  GET: 'text-status-info',
+  POST: 'text-status-success',
+  PUT: 'text-accent-foreground',
+  PATCH: 'text-status-warning',
+  DELETE: 'text-status-error',
+}
+
+function Sparkline({ values }: { values: number[] }) {
+  if (values.length < 2) return <div className="h-4 w-14" />
+  const max = Math.max(...values, 1)
+  const points = values
+    .map((v, i) => `${(i / (values.length - 1)) * 100},${16 - (v / max) * 16}`)
+    .join(' ')
+  return (
+    <svg viewBox="0 0 100 16" className="h-4 w-14 overflow-visible" preserveAspectRatio="none" aria-hidden="true">
+      <polyline points={points} fill="none" stroke="var(--color-muted-foreground)" strokeWidth={1.5} vectorEffect="non-scaling-stroke" />
+    </svg>
+  )
+}
+
+export function EndpointsTable({ rows }: { rows: EndpointRow[] }) {
+  const [sortKey, setSortKey] = useState<SortKey>('rps')
+  const [sortDir, setSortDir] = useState<SortDir>('desc')
+
+  const sorted = useMemo(() => {
+    const copy = [...rows]
+    copy.sort((a, b) => {
+      let diff = 0
+      if (sortKey === 'path') diff = a.endpoint.path.localeCompare(b.endpoint.path)
+      else if (sortKey === 'status') diff = STATUS_RANK[a.status] - STATUS_RANK[b.status]
+      else diff = a[sortKey] - b[sortKey]
+      return sortDir === 'asc' ? diff : -diff
+    })
+    return copy
+  }, [rows, sortKey, sortDir])
+
+  function handleSort(key: SortKey) {
+    if (key === sortKey) {
+      setSortDir((d) => (d === 'asc' ? 'desc' : 'asc'))
+    } else {
+      setSortKey(key)
+      setSortDir(key === 'path' ? 'asc' : 'desc')
+    }
+  }
+
+  return (
+    <div className="flex flex-col">
+      <div className="mb-3">
+        <h2 className="text-sm font-semibold text-foreground">Active endpoints</h2>
+        <p className="text-xs text-muted-foreground">Rolling 30s window · sorted by {COLUMNS.find((c) => c.key === sortKey)?.label.toLowerCase()}</p>
+      </div>
+      <div className="overflow-x-auto rounded-md border border-border">
+        <table className="w-full border-collapse text-sm">
+          <thead>
+            <tr className="border-b border-border bg-muted/50">
+              {COLUMNS.map((col) => (
+                <th key={col.key} scope="col" className={clsx('px-3 py-0 font-medium text-muted-foreground', col.align === 'right' && 'text-right')}>
+                  <button
+                    type="button"
+                    onClick={() => handleSort(col.key)}
+                    className={clsx(
+                      'inline-flex items-center gap-1 px-1 py-2.5 text-[11px] font-medium uppercase tracking-wide hover:text-foreground',
+                      col.align === 'right' && 'flex-row-reverse',
+                    )}
+                  >
+                    {col.label}
+                    {sortKey === col.key && <span aria-hidden="true">{sortDir === 'asc' ? '▲' : '▼'}</span>}
+                  </button>
+                </th>
+              ))}
+              <th scope="col" className="px-3 py-2 text-right text-[11px] font-medium uppercase tracking-wide text-muted-foreground">
+                Trend
+              </th>
+            </tr>
+          </thead>
+          <tbody>
+            {sorted.map((row) => (
+              <tr key={row.endpoint.id} className="border-b border-border last:border-b-0 hover:bg-muted/40">
+                <td className="px-3 py-2">
+                  <div className="flex items-center gap-2">
+                    <span className={clsx('w-14 shrink-0 font-mono text-[11px] font-semibold', METHOD_COLOR[row.endpoint.method])}>
+                      {row.endpoint.method}
+                    </span>
+                    <span className="truncate font-mono text-[12.5px] text-foreground">{row.endpoint.path}</span>
+                  </div>
+                </td>
+                <td className="px-3 py-2 text-right tabular-nums text-foreground">{formatRps(row.rps)}</td>
+                <td
+                  className={clsx(
+                    'px-3 py-2 text-right tabular-nums',
+                    row.errorRatePct >= 15 ? 'text-status-error' : row.errorRatePct >= 5 ? 'text-status-warning' : 'text-foreground',
+                  )}
+                >
+                  {formatPct(row.errorRatePct)}
+                </td>
+                <td className="px-3 py-2 text-right tabular-nums text-foreground">{formatMs(row.p95)}</td>
+                <td className="px-3 py-2 text-right tabular-nums text-foreground">{formatMs(row.p99)}</td>
+                <td className="px-3 py-2">
+                  <StatusBadge status={row.status} />
+                </td>
+                <td className="px-3 py-2 text-right">
+                  <div className="flex justify-end">
+                    <Sparkline values={row.trend} />
+                  </div>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  )
+}
