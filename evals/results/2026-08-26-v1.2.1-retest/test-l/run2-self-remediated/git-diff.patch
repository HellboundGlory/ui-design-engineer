+import type { EndpointDef, EndpointRow, EndpointStatus, TimeRangeKey, TrafficTick } from '../types'
+import { TICK_MS } from './trafficEngine'
+
+export const TIME_RANGES: { key: TimeRangeKey; label: string; ms: number }[] = [
+  { key: '5m', label: '5m', ms: 5 * 60 * 1000 },
+  { key: '15m', label: '15m', ms: 15 * 60 * 1000 },
+  { key: '1h', label: '1h', ms: 60 * 60 * 1000 },
+  { key: '6h', label: '6h', ms: 6 * 60 * 60 * 1000 },
+]
+
+export function sliceRange(ticks: TrafficTick[], rangeMs: number): TrafficTick[] {
+  const count = Math.ceil(rangeMs / TICK_MS)
+  return ticks.slice(-count)
+}
+
+/** Groups ticks into ~targetPoints bins so charts stay legible across wide ranges. */
+export function downsample(ticks: TrafficTick[], targetPoints = 90): TrafficTick[] {
+  if (ticks.length <= targetPoints) return ticks
+  const binSize = Math.ceil(ticks.length / targetPoints)
+  const result: TrafficTick[] = []
+
+  for (let i = 0; i < ticks.length; i += binSize) {
+    const bin = ticks.slice(i, i + binSize)
+    const requests = bin.reduce((sum, t) => sum + t.requests, 0)
+    const errors = bin.reduce((sum, t) => sum + t.errors, 0)
+    result.push({
+      t: bin[bin.length - 1].t,
+      requests,
+      errors,
+      rps: average(bin.map((t) => t.rps)),
+      errorRatePct: average(bin.map((t) => t.errorRatePct)),
+      p50: average(bin.map((t) => t.p50)),
+      p95: average(bin.map((t) => t.p95)),
+      p99: average(bin.map((t) => t.p99)),
+      perEndpoint: {},
+    })
+  }
+  return result
+}
+
+function average(values: number[]): number {
+  if (values.length === 0) return 0
+  return values.reduce((a, b) => a + b, 0) / values.length
+}
+
+const ROLLING_WINDOW_TICKS = 15 // ~30s
+
+export function buildEndpointRows(
+  ticks: TrafficTick[],
+  endpoints: EndpointDef[],
+  incidentSeverityByEndpoint: Map<string, EndpointStatus>,
+): EndpointRow[] {
+  const window = ticks.slice(-ROLLING_WINDOW_TICKS)
+  const windowSeconds = (window.length * TICK_MS) / 1000
+
+  return endpoints.map((endpoint) => {
+    let requests = 0
+    let errors = 0
+    let p95Sum = 0
+    let p99Sum = 0
+    const trend: number[] = []
+
+    for (const tick of window) {
+      const t = tick.perEndpoint[endpoint.id]
+      if (!t) continue
+      requests += t.requests
+      errors += t.errors
+      p95Sum += t.p95 * t.requests
+      p99Sum += t.p99 * t.requests
+      trend.push(t.requests)
+    }
+
+    const safeRequests = Math.max(1, requests)
+    const errorRatePct = (errors / safeRequests) * 100
+    const p95 = requests > 0 ? Math.round(p95Sum / safeRequests) : 0
+    const p99 = requests > 0 ? Math.round(p99Sum / safeRequests) : 0
+    const rps = windowSeconds > 0 ? requests / windowSeconds : 0
+
+    let status: EndpointStatus = 'healthy'
+    if (errorRatePct >= 15) {
+      status = 'critical'
+    } else if (errorRatePct >= 5) {
+      status = 'warning'
+    }
+    const incidentStatus = incidentSeverityByEndpoint.get(endpoint.id)
+    if (incidentStatus === 'critical' || (incidentStatus === 'warning' && status === 'healthy')) {
+      status = incidentStatus
+    }
+
+    return { endpoint, rps, errorRatePct, p95, p99, requests, status, trend }
+  })
+}
+
+export function formatNumber(value: number): string {
+  if (value >= 1_000_000) return `${(value / 1_000_000).toFixed(1)}M`
+  if (value >= 1_000) return `${(value / 1_000).toFixed(1)}K`
+  return Math.round(value).toString()
+}
+
+export function formatRps(value: number): string {
+  return value >= 1000 ? formatNumber(value) : value.toFixed(1)
+}
+
+export function formatMs(value: number): string {
+  if (value >= 1000) return `${(value / 1000).toFixed(2)}s`
+  return `${Math.round(value)}ms`
+}
+
+export function formatPct(value: number): string {
+  return `${value.toFixed(2)}%`
+}
+
+export function formatClockTime(t: number): string {
+  return new Date(t).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' })
+}
diff --git a/src/lib/trafficEngine.ts b/src/lib/trafficEngine.ts
new file mode 100644
index 0000000..5a27049
--- /dev/null
+++ b/src/lib/trafficEngine.ts
@@ -0,0 +1,200 @@
+import { ENDPOINTS } from './endpoints'
+import type { EndpointDef, EndpointTick, EngineSnapshot, Incident, TrafficTick } from '../types'
+
+export const TICK_MS = 2000
+const HISTORY_TICKS = 1800 // 1 hour of history at 2s resolution
+
+interface EndpointRuntimeState {
+  rpsFactor: number
+  latencyFactor: number
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(max, Math.max(min, value))
+}
+
+function smoothedRandomWalk(prev: number, min: number, max: number, drift = 0.35): number {
+  const next = prev + (Math.random() - 0.5) * drift
+  return clamp(next, min, max)
+}
+
+function poissonish(mean: number): number {
+  // Fast approximation adequate for mock traffic volumes; avoids a real
+  // Poisson sampler while still producing integer counts with natural jitter.
+  if (mean <= 0) return 0
+  const gaussian = Math.sqrt(mean) * (Math.random() + Math.random() + Math.random() - 1.5)
+  return Math.max(0, Math.round(mean + gaussian))
+}
+
+function createRuntimeState(): Record<string, EndpointRuntimeState> {
+  const state: Record<string, EndpointRuntimeState> = {}
+  for (const ep of ENDPOINTS) {
+    state[ep.id] = { rpsFactor: 1, latencyFactor: 1 }
+  }
+  return state
+}
+
+function generateEndpointTick(
+  ep: EndpointDef,
+  state: EndpointRuntimeState,
+  activeIncident: Incident | undefined,
+  tickSeconds: number,
+): EndpointTick {
+  state.rpsFactor = smoothedRandomWalk(state.rpsFactor, 0.55, 1.6)
+  state.latencyFactor = smoothedRandomWalk(state.latencyFactor, 0.85, 1.25, 0.12)
+
+  const incidentLatencyMultiplier = activeIncident ? (activeIncident.severity === 'critical' ? 4.2 : 2.1) : 1
+  const incidentErrorAdd = activeIncident ? (activeIncident.severity === 'critical' ? 0.45 : 0.16) : 0
+
+  const requests = poissonish(ep.baseRps * tickSeconds * state.rpsFactor)
+  const effectiveErrorRate = clamp(ep.baseErrorRate + incidentErrorAdd + (Math.random() - 0.5) * 0.006, 0, 0.98)
+  const errors = Math.min(requests, poissonish(requests * effectiveErrorRate))
+
+  const p50 = ep.baseLatencyP50 * state.latencyFactor
+  const p95 = p50 * (2.1 + Math.random() * 0.4) * incidentLatencyMultiplier
+  const p99 = p95 * (1.45 + Math.random() * 0.3) * (incidentLatencyMultiplier > 1 ? 1.15 : 1)
+
+  return {
+    requests,
+    errors,
+    p50: Math.round(p50),
+    p95: Math.round(p95),
+    p99: Math.round(p99),
+  }
+}
+
+function aggregateTick(t: number, perEndpoint: Record<string, EndpointTick>, tickSeconds: number): TrafficTick {
+  let requests = 0
+  let errors = 0
+  let p50Weighted = 0
+  let p95Weighted = 0
+  let p99Weighted = 0
+
+  for (const ep of ENDPOINTS) {
+    const tick = perEndpoint[ep.id]
+    requests += tick.requests
+    errors += tick.errors
+    p50Weighted += tick.p50 * tick.requests
+    p95Weighted += tick.p95 * tick.requests
+    p99Weighted += tick.p99 * tick.requests
+  }
+
+  const safeRequests = Math.max(1, requests)
+
+  return {
+    t,
+    requests,
+    errors,
+    rps: requests / tickSeconds,
+    errorRatePct: (errors / safeRequests) * 100,
+    p50: Math.round(p50Weighted / safeRequests),
+    p95: Math.round(p95Weighted / safeRequests),
+    p99: Math.round(p99Weighted / safeRequests),
+    perEndpoint,
+  }
+}
+
+function maybeStartIncident(now: number, active: Incident[]): Incident | null {
+  if (active.length >= 2) return null
+  if (Math.random() > 0.006) return null
+
+  const candidates = ENDPOINTS.filter((ep) => !active.some((inc) => inc.endpointId === ep.id))
+  if (candidates.length === 0) return null
+
+  const ep = candidates[Math.floor(Math.random() * candidates.length)]
+  const severity = Math.random() < 0.35 ? 'critical' : 'warning'
+  const durationTicks = 8 + Math.floor(Math.random() * 12) // 16s - 40s
+  return {
+    id: `${ep.id}-${now}`,
+    endpointId: ep.id,
+    severity,
+    startedAt: now,
+    endsAt: now + durationTicks * TICK_MS,
+  }
+}
+
+type Listener = () => void
+
+function createEngine() {
+  const runtimeState = createRuntimeState()
+  let ticks: TrafficTick[] = []
+  const incidentHistory: Incident[] = []
+  let live = true
+  const listeners = new Set<Listener>()
+
+  let snapshot: EngineSnapshot = { ticks: [], incidents: [], endpoints: ENDPOINTS, live }
+
+  function activeIncidentsAt(now: number): Incident[] {
+    return incidentHistory.filter((inc) => inc.startedAt <= now && inc.endsAt > now)
+  }
+
+  function runTick(simTime: number) {
+    const active = activeIncidentsAt(simTime)
+    const started = maybeStartIncident(simTime, active)
+    if (started) {
+      incidentHistory.push(started)
+      active.push(started)
+    }
+
+    const tickSeconds = TICK_MS / 1000
+    const perEndpoint: Record<string, EndpointTick> = {}
+    for (const ep of ENDPOINTS) {
+      const incident = active.find((inc) => inc.endpointId === ep.id)
+      perEndpoint[ep.id] = generateEndpointTick(ep, runtimeState[ep.id], incident, tickSeconds)
+    }
+
+    const tick = aggregateTick(simTime, perEndpoint, tickSeconds)
+    ticks.push(tick)
+    if (ticks.length > HISTORY_TICKS) {
+      ticks = ticks.slice(ticks.length - HISTORY_TICKS)
+    }
+  }
+
+  function seedHistory() {
+    const now = Date.now()
+    const start = now - HISTORY_TICKS * TICK_MS
+    for (let i = 0; i < HISTORY_TICKS; i++) {
+      runTick(start + i * TICK_MS)
+    }
+  }
+
+  function publish() {
+    const now = ticks.length > 0 ? ticks[ticks.length - 1].t : Date.now()
+    snapshot = {
+      ticks,
+      incidents: incidentHistory.filter((inc) => inc.endsAt > now - 5 * 60 * 1000),
+      endpoints: ENDPOINTS,
+      live,
+    }
+    for (const listener of listeners) listener()
+  }
+
+  seedHistory()
+  publish()
+
+  const interval = setInterval(() => {
+    if (!live) return
+    runTick(Date.now())
+    publish()
+  }, TICK_MS)
+
+  if (typeof window !== 'undefined') {
+    window.addEventListener('beforeunload', () => clearInterval(interval))
+  }
+
+  return {
+    subscribe(listener: Listener) {
+      listeners.add(listener)
+      return () => listeners.delete(listener)
+    },
+    getSnapshot(): EngineSnapshot {
+      return snapshot
+    },
+    setLive(next: boolean) {
+      live = next
+      publish()
+    },
+  }
+}
+
+export const trafficEngine = createEngine()
