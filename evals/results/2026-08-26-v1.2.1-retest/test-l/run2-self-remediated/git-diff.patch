+import clsx from 'clsx'
+import type { EndpointDef, Incident } from '../types'
+
+export function IncidentBanner({ incidents, endpoints, now }: { incidents: Incident[]; endpoints: EndpointDef[]; now: number }) {
+  const active = incidents.filter((inc) => inc.endsAt > now)
+  if (active.length === 0) return null
+
+  return (
+    <div className="flex flex-col gap-1.5">
+      {active.map((incident) => {
+        const endpoint = endpoints.find((e) => e.id === incident.endpointId)
+        const critical = incident.severity === 'critical'
+        return (
+          <div
+            key={incident.id}
+            role="alert"
+            className={clsx(
+              'flex items-center gap-2 rounded-md border px-3 py-2 text-xs',
+              critical ? 'border-status-error/30 bg-status-error/10 text-status-error' : 'border-status-warning/30 bg-status-warning/10 text-status-warning',
+            )}
+          >
+            <span className={clsx('h-1.5 w-1.5 shrink-0 rounded-full', critical ? 'bg-status-error' : 'bg-status-warning')} aria-hidden="true" />
+            <span className="font-medium">{critical ? 'Critical' : 'Elevated errors'}</span>
+            <span className="font-mono">
+              {endpoint?.method} {endpoint?.path}
+            </span>
+            <span className="text-muted-foreground">
+              {critical ? 'error and latency spike detected' : 'error rate above baseline'}
+            </span>
+          </div>
+        )
+      })}
+    </div>
+  )
+}
