@@ -0,0 +1,116 @@
+import { useEffect, useMemo, useState } from 'react'
+import { useTrafficStream, setStreamLive } from './hooks/useTrafficStream'
+import { buildEndpointRows, downsample, sliceRange, TIME_RANGES } from './lib/metrics'
+import { TimeRangeControl } from './components/TimeRangeControl'
+import { LiveIndicator } from './components/LiveIndicator'
+import { MetricStrip } from './components/MetricStrip'
+import { IncidentBanner } from './components/IncidentBanner'
+import { ThroughputChart } from './components/ThroughputChart'
+import { ErrorRateChart } from './components/ErrorRateChart'
+import { LatencyChart } from './components/LatencyChart'
+import { EndpointsTable } from './components/EndpointsTable'
+import type { TimeRangeKey } from './types'
+
+function useTheme() {
+  const [theme, setTheme] = useState<'dark' | 'light'>('dark')
+  useEffect(() => {
+    document.documentElement.dataset.theme = theme
+  }, [theme])
+  return { theme, toggle: () => setTheme((t) => (t === 'dark' ? 'light' : 'dark')) }
+}
+
+export default function App() {
+  const snapshot = useTrafficStream()
+  const [range, setRange] = useState<TimeRangeKey>('15m')
+  const { theme, toggle } = useTheme()
+
+  const rangeMs = TIME_RANGES.find((r) => r.key === range)?.ms ?? TIME_RANGES[1].ms
+  const scoped = useMemo(() => sliceRange(snapshot.ticks, rangeMs), [snapshot.ticks, rangeMs])
+  const chartData = useMemo(() => downsample(scoped, 100), [scoped])
+
+  const latest = snapshot.ticks[snapshot.ticks.length - 1]
+  const compareWindow = 30 // ticks (~60s) to compare current vs prior for deltas
+  const recent = snapshot.ticks.slice(-compareWindow)
+  const prior = snapshot.ticks.slice(-compareWindow * 2, -compareWindow)
+  const avg = (arr: typeof recent, key: 'rps' | 'errorRatePct') =>
+    arr.length ? arr.reduce((sum, t) => sum + t[key], 0) / arr.length : 0
+  const rpsDelta = prior.length ? ((avg(recent, 'rps') - avg(prior, 'rps')) / Math.max(1e-6, avg(prior, 'rps'))) * 100 : 0
+  const errorDelta = prior.length
+    ? ((avg(recent, 'errorRatePct') - avg(prior, 'errorRatePct')) / Math.max(1e-6, avg(prior, 'errorRatePct'))) * 100
+    : 0
+
+  const now = Date.now()
+  const incidentSeverityByEndpoint = new Map(
+    snapshot.incidents.filter((inc) => inc.endsAt > now).map((inc) => [inc.endpointId, inc.severity] as const),
+  )
+  const rows = useMemo(
+    () => buildEndpointRows(snapshot.ticks, snapshot.endpoints, incidentSeverityByEndpoint),
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [snapshot.ticks, snapshot.endpoints],
+  )
+  const openIncidents = rows.filter((r) => r.status !== 'healthy').length
+
+  return (
+    <div className="mx-auto flex min-h-screen max-w-[1400px] flex-col gap-4 px-4 py-4 sm:px-6 lg:px-8">
+      <header className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2.5">
+          <div className="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground">
+            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+              <path d="M3 12h4l2-7 4 14 2-7h6" stroke="currentColor" strokeWidth={2.4} strokeLinecap="round" strokeLinejoin="round" />
+            </svg>
+          </div>
+          <div>
+            <h1 className="text-sm font-semibold leading-tight text-foreground">Ingress</h1>
+            <p className="text-[11px] leading-tight text-muted-foreground">API traffic analytics</p>
+          </div>
+        </div>
+        <div className="flex flex-wrap items-center gap-2.5">
+          <LiveIndicator live={snapshot.live} onToggle={() => setStreamLive(!snapshot.live)} />
+          <TimeRangeControl value={range} onChange={setRange} />
+          <button
+            type="button"
+            onClick={toggle}
+            className="rounded-md border border-border bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-foreground"
+            aria-label={`Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`}
+          >
+            {theme === 'dark' ? 'Dark' : 'Light'}
+          </button>
+        </div>
+      </header>
+
+      <IncidentBanner incidents={snapshot.incidents} endpoints={snapshot.endpoints} now={now} />
+
+      <MetricStrip
+        rps={latest?.rps ?? 0}
+        errorRatePct={latest?.errorRatePct ?? 0}
+        p95={latest?.p95 ?? 0}
+        p99={latest?.p99 ?? 0}
+        activeEndpoints={snapshot.endpoints.length}
+        openIncidents={openIncidents}
+        rpsDelta={rpsDelta}
+        errorDelta={errorDelta}
+      />
+
+      <div className="grid flex-1 grid-cols-1 gap-4 lg:grid-cols-2">
+        <div className="h-72 rounded-md border border-border bg-surface p-4">
+          <ThroughputChart data={chartData} />
+        </div>
+        <div className="h-72 rounded-md border border-border bg-surface p-4">
+          <ErrorRateChart data={chartData} />
+        </div>
+      </div>
+
+      <div className="h-72 rounded-md border border-border bg-surface p-4">
+        <LatencyChart data={chartData} />
+      </div>
+
+      <div className="rounded-md border border-border bg-surface p-4">
+        <EndpointsTable rows={rows} />
+      </div>
+
+      <footer className="pb-2 pt-1 text-center text-[11px] text-muted-foreground">
+        Simulated traffic for demonstration · updates every {2}s
+      </footer>
+    </div>
+  )
+}
