@@ -0,0 +1,36 @@
+import { formatClockTime } from '../lib/metrics'
+
+export interface TooltipRow {
+  label: string
+  value: string
+  color: string
+}
+
+export function ChartTooltip({
+  active,
+  timestamp,
+  rows,
+}: {
+  active?: boolean
+  timestamp?: number
+  rows: TooltipRow[]
+}) {
+  if (!active || timestamp === undefined) return null
+
+  return (
+    <div className="min-w-[10rem] rounded-md border border-border bg-surface px-3 py-2 text-xs shadow-lg">
+      <div className="mb-1.5 text-muted-foreground tabular-nums">{formatClockTime(timestamp)}</div>
+      <div className="flex flex-col gap-1">
+        {rows.map((row) => (
+          <div key={row.label} className="flex items-center justify-between gap-4">
+            <span className="flex items-center gap-1.5 text-muted-foreground">
+              <span className="h-2 w-2 rounded-full" style={{ backgroundColor: row.color }} aria-hidden="true" />
+              {row.label}
+            </span>
+            <span className="font-medium tabular-nums text-foreground">{row.value}</span>
+          </div>
+        ))}
+      </div>
+    </div>
+  )
+}
