+export type HttpMethod = 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE'
+
+export type Severity = 'warning' | 'critical'
+
+export interface EndpointDef {
+  id: string
+  method: HttpMethod
+  path: string
+  service: string
+  /** baseline requests/sec under normal conditions */
+  baseRps: number
+  /** baseline error rate as a fraction (0-1) under normal conditions */
+  baseErrorRate: number
+  /** baseline p50 latency in ms under normal conditions */
+  baseLatencyP50: number
+}
+
+export interface EndpointTick {
+  requests: number
+  errors: number
+  p50: number
+  p95: number
+  p99: number
+}
+
+export interface TrafficTick {
+  /** epoch ms this bucket ended at */
+  t: number
+  requests: number
+  errors: number
+  rps: number
+  errorRatePct: number
+  p50: number
+  p95: number
+  p99: number
+  perEndpoint: Record<string, EndpointTick>
+}
+
+export interface Incident {
+  id: string
+  endpointId: string
+  severity: Severity
+  startedAt: number
+  endsAt: number
+}
+
+export interface EngineSnapshot {
+  ticks: TrafficTick[]
+  incidents: Incident[]
+  endpoints: EndpointDef[]
+  live: boolean
+}
+
+export type EndpointStatus = 'healthy' | 'warning' | 'critical'
+
+export interface EndpointRow {
+  endpoint: EndpointDef
+  rps: number
+  errorRatePct: number
+  p95: number
+  p99: number
+  requests: number
+  status: EndpointStatus
+  trend: number[]
+}
+
+export type TimeRangeKey = '5m' | '15m' | '1h' | '6h'
