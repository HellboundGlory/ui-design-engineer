+}
diff --git a/src/components/EndpointTable.tsx b/src/components/EndpointTable.tsx
new file mode 100644
index 0000000..6a22404
--- /dev/null
+++ b/src/components/EndpointTable.tsx
@@ -0,0 +1,157 @@
+import { useMemo, useState } from "react";
+import { clsx } from "clsx";
+import { ArrowDown, ArrowUp, ChevronsUpDown } from "lucide-react";
+import type { EndpointSnapshot, HttpMethod, TrafficTick } from "../lib/traffic-simulator";
+import { formatMs, formatPct, formatRps } from "../lib/format";
+import { palette } from "../lib/palette";
+import { StatusDot } from "./StatusDot";
+import { Sparkline } from "./Sparkline";
+
+const TREND_WINDOW = 30; // most recent ticks used for the sparkline, independent of the chart time-range selector
+
+type SortKey = "path" | "rps" | "errorRatePct" | "p50" | "p95" | "p99" | "status";
+
+const STATUS_RANK: Record<EndpointSnapshot["status"], number> = { error: 2, degraded: 1, healthy: 0 };
+
+const METHOD_TONE: Record<HttpMethod, string> = {
+  GET: "text-status-info",
+  POST: "text-status-success",
+  PUT: "text-status-warning",
+  DELETE: "text-status-error",
+};
+
+interface Column {
+  key: SortKey;
+  label: string;
+  align?: "left" | "right";
+}
+
+const COLUMNS: Column[] = [
+  { key: "status", label: "" },
+  { key: "path", label: "Endpoint" },
+  { key: "rps", label: "Req/sec", align: "right" },
+  { key: "errorRatePct", label: "Error rate", align: "right" },
+  { key: "p50", label: "p50", align: "right" },
+  { key: "p95", label: "p95", align: "right" },
+  { key: "p99", label: "p99", align: "right" },
+];
+
+export function EndpointTable({ history }: { history: TrafficTick[] }) {
+  const [sort, setSort] = useState<{ key: SortKey; dir: "asc" | "desc" }>({ key: "rps", dir: "desc" });
+
+  const latest = history[history.length - 1];
+  const trendSlice = history.slice(-TREND_WINDOW);
+
+  const rows = useMemo(() => {
+    if (!latest) return [];
+    return latest.endpoints.map((endpoint) => ({
+      ...endpoint,
+      trend: trendSlice.map((tick) => tick.endpoints.find((e) => e.id === endpoint.id)?.rps ?? 0),
+    }));
+  }, [latest, trendSlice]);
+
+  const sorted = useMemo(() => {
+    const copy = [...rows];
+    copy.sort((a, b) => {
+      let diff: number;
+      if (sort.key === "path") diff = a.path.localeCompare(b.path);
+      else if (sort.key === "status") diff = STATUS_RANK[a.status] - STATUS_RANK[b.status];
+      else diff = a[sort.key] - b[sort.key];
+      return sort.dir === "asc" ? diff : -diff;
+    });
+    return copy;
+  }, [rows, sort]);
+
+  function toggleSort(key: SortKey) {
+    setSort((prev) => (prev.key === key ? { key, dir: prev.dir === "asc" ? "desc" : "asc" } : { key, dir: "desc" }));
+  }
+
+  const trendColorFor = (status: EndpointSnapshot["status"]) =>
+    status === "error" ? palette.statusError : status === "degraded" ? palette.statusWarning : palette.mutedForeground;
+
+  return (
+    <section className="flex flex-col rounded-lg border border-border bg-surface">
+      <div className="flex items-center justify-between border-b border-border px-4 py-3">
+        <div>
+          <h2 className="text-[13px] font-semibold leading-tight">Active endpoints</h2>
+          <p className="mt-0.5 text-[11px] text-muted-foreground">{rows.length} endpoints receiving traffic</p>
+        </div>
+      </div>
+
+      <div className="overflow-x-auto">
+        <table className="w-full min-w-[720px] border-collapse text-[12px]">
+          <thead>
+            <tr className="border-b border-border-subtle text-left text-[11px] text-muted-foreground">
+              {COLUMNS.map((col) => (
+                <th key={col.key} scope="col" className={clsx("px-4 py-2 font-medium", col.align === "right" && "text-right")}>
+                  {col.label ? (
+                    <button
+                      type="button"
+                      onClick={() => toggleSort(col.key)}
+                      className={clsx(
+                        "inline-flex items-center gap-1 rounded py-1.5 hover:text-foreground focus:outline-none focus:ring-2 focus:ring-primary/60",
+                        col.align === "right" && "flex-row-reverse",
+                      )}
+                    >
+                      {col.label}
+                      {sort.key === col.key ? (
+                        sort.dir === "asc" ? (
+                          <ArrowUp className="size-3" strokeWidth={2} />
+                        ) : (
+                          <ArrowDown className="size-3" strokeWidth={2} />
+                        )
+                      ) : (
+                        <ChevronsUpDown className="size-3 opacity-40" strokeWidth={2} />
+                      )}
+                    </button>
+                  ) : (
+                    <span className="sr-only">Status</span>
+                  )}
+                </th>
+              ))}
+              <th scope="col" className="px-4 py-2 text-right font-medium">
+                Trend
+              </th>
+            </tr>
+          </thead>
+          <tbody>
+            {sorted.map((row) => (
+              <tr
+                key={row.id}
+                className="border-b border-border-subtle last:border-0 hover:bg-surface-raised transition-colors duration-150"
+                style={{ height: 36 }}
+              >
+                <td className="px-4">
+                  <StatusDot status={row.status} />
+                </td>
+                <td className="px-4 py-1.5">
+                  <span className={clsx("num mr-2 inline-block w-12 text-[11px] font-semibold", METHOD_TONE[row.method])}>
+                    {row.method}
+                  </span>
+                  <span className="num text-foreground">{row.path}</span>
+                </td>
+                <td className="num px-4 py-1.5 text-right">{formatRps(row.rps)}</td>
+                <td
+                  className={clsx(
+                    "num px-4 py-1.5 text-right",
+                    row.status === "error" ? "text-status-error" : row.status === "degraded" ? "text-status-warning" : "text-foreground",
+                  )}
+                >
+                  {formatPct(row.errorRatePct)}
+                </td>
+                <td className="num px-4 py-1.5 text-right text-muted-foreground">{formatMs(row.p50)}</td>
+                <td className="num px-4 py-1.5 text-right text-muted-foreground">{formatMs(row.p95)}</td>
+                <td className="num px-4 py-1.5 text-right">{formatMs(row.p99)}</td>
+                <td className="px-4 py-1.5">
+                  <div className="flex justify-end">
+                    <Sparkline values={row.trend} color={trendColorFor(row.status)} />
+                  </div>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/ErrorRateChart.tsx b/src/components/ErrorRateChart.tsx
new file mode 100644
