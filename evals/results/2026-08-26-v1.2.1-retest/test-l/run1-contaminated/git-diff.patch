diff --git a/src/hooks/useTrafficData.ts b/src/hooks/useTrafficData.ts
new file mode 100644
index 0000000..6f56f2c
--- /dev/null
+++ b/src/hooks/useTrafficData.ts
@@ -0,0 +1,66 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { createTrafficSimulator, seedHistory, type TrafficTick } from "../lib/traffic-simulator";
+
+export const TICK_INTERVAL_MS = 2000;
+const MAX_BUFFER_POINTS = 900; // 30 minutes at a 2s tick
+
+export const TIME_RANGES = [
+  { label: "5m", ms: 5 * 60 * 1000 },
+  { label: "15m", ms: 15 * 60 * 1000 },
+  { label: "30m", ms: 30 * 60 * 1000 },
+] as const;
+
+export type TimeRangeLabel = (typeof TIME_RANGES)[number]["label"];
+
+export function useTrafficData() {
+  const [{ sim, seededHistory }] = useState(() => {
+    const sim = createTrafficSimulator();
+    return { sim, seededHistory: seedHistory(sim, MAX_BUFFER_POINTS, TICK_INTERVAL_MS) };
+  });
+  const simRef = useRef(sim);
+  const [history, setHistory] = useState<TrafficTick[]>(seededHistory);
+  const [paused, setPaused] = useState(false);
+  const [timeRange, setTimeRange] = useState<TimeRangeLabel>("15m");
+
+  useEffect(() => {
+    if (paused) return;
+    const id = window.setInterval(() => {
+      setHistory((prev) => {
+        const next = [...prev, simRef.current.tick()];
+        if (next.length > MAX_BUFFER_POINTS) next.shift();
+        return next;
+      });
+    }, TICK_INTERVAL_MS);
+    return () => window.clearInterval(id);
+  }, [paused]);
+
+  const rangeMs = TIME_RANGES.find((r) => r.label === timeRange)?.ms ?? TIME_RANGES[1].ms;
+  const latestTimestamp = history[history.length - 1]?.t;
+
+  // Anchored to the latest data timestamp rather than the wall clock, so the
+  // visible window doesn't keep sliding (and emptying out) while paused.
+  const visibleHistory = useMemo(() => {
+    if (latestTimestamp === undefined) return history;
+    const cutoff = latestTimestamp - rangeMs;
+    return history.filter((tick) => tick.t >= cutoff);
+  }, [history, rangeMs, latestTimestamp]);
+
+  const latest = history[history.length - 1];
+  const previousWindowErrorRate = useMemo(() => {
+    if (visibleHistory.length < 4) return latest?.errorRatePct ?? 0;
+    const midpoint = Math.floor(visibleHistory.length / 2);
+    const firstHalf = visibleHistory.slice(0, midpoint);
+    return firstHalf.reduce((sum, t) => sum + t.errorRatePct, 0) / (firstHalf.length || 1);
+  }, [visibleHistory, latest]);
+
+  return {
+    history,
+    visibleHistory,
+    latest,
+    previousWindowErrorRate,
+    paused,
+    setPaused,
+    timeRange,
+    setTimeRange,
+  };
+}
