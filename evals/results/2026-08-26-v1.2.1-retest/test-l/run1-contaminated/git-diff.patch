+++ b/src/components/LatencyChart.tsx
@@ -0,0 +1,91 @@
+import { CartesianGrid, Line, LineChart, ReferenceLine, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";
+import type { TrafficTick } from "../lib/traffic-simulator";
+import { P99_WARNING_MS } from "../lib/traffic-simulator";
+import { formatAxisTime, formatMs } from "../lib/format";
+import { palette } from "../lib/palette";
+import { ChartPanel } from "./ChartPanel";
+import { ChartTooltipShell } from "./ChartTooltip";
+
+const SERIES = [
+  { key: "p50", label: "p50", color: palette.statusInfo },
+  { key: "p95", label: "p95", color: palette.statusWarning },
+  { key: "p99", label: "p99", color: palette.statusError },
+] as const;
+
+export function LatencyChart({ data }: { data: TrafficTick[] }) {
+  const rows = data.map((tick) => ({ t: tick.t, p50: tick.p50, p95: tick.p95, p99: tick.p99 }));
+
+  return (
+    <ChartPanel
+      title="Latency percentiles"
+      subtitle="Response time distribution across all endpoints"
+      legend={
+        <ul className="flex items-center gap-3">
+          {SERIES.map((s) => (
+            <li key={s.key} className="flex items-center gap-1.5 text-[11px] text-muted-foreground">
+              <span className="h-0.5 w-3 rounded-full" style={{ backgroundColor: s.color }} aria-hidden="true" />
+              {s.label}
+            </li>
+          ))}
+        </ul>
+      }
+      className="h-[240px]"
+    >
+      <ResponsiveContainer width="100%" height="100%">
+        <LineChart data={rows} margin={{ top: 4, right: 8, left: 0, bottom: 0 }}>
