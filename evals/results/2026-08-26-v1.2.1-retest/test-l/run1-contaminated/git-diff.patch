--- /dev/null
+++ b/src/lib/traffic-simulator.ts
@@ -0,0 +1,195 @@
+export type HttpMethod = "GET" | "POST" | "PUT" | "DELETE";
+
+export type EndpointStatus = "healthy" | "degraded" | "error";
+
+export interface EndpointConfig {
+  id: string;
+  method: HttpMethod;
+  path: string;
+  baseRps: number;
+  baseP50: number;
+  baseP95: number;
+  baseP99: number;
+  baseErrorRate: number;
+}
+
+export interface EndpointSnapshot {
+  id: string;
+  method: HttpMethod;
+  path: string;
+  rps: number;
+  errorRatePct: number;
+  p50: number;
+  p95: number;
+  p99: number;
+  status: EndpointStatus;
+}
+
+export interface StatusBreakdown {
+  ok: number;
+  redirect: number;
+  clientError: number;
+  serverError: number;
+}
+
+export interface TrafficTick {
+  t: number;
+  totalRps: number;
+  errorRatePct: number;
+  p50: number;
+  p95: number;
+  p99: number;
+  statusBreakdown: StatusBreakdown;
+  endpoints: EndpointSnapshot[];
+}
+
+export const ERROR_RATE_WARNING_PCT = 2;
+export const ERROR_RATE_CRITICAL_PCT = 5;
+export const P99_WARNING_MS = 500;
+export const P99_CRITICAL_MS = 900;
+
+export const ENDPOINTS: EndpointConfig[] = [
+  { id: "get-users", method: "GET", path: "/api/users", baseRps: 42, baseP50: 38, baseP95: 95, baseP99: 160, baseErrorRate: 0.3 },
+  { id: "post-users", method: "POST", path: "/api/users", baseRps: 6, baseP50: 85, baseP95: 180, baseP99: 260, baseErrorRate: 0.8 },
+  { id: "get-user-by-id", method: "GET", path: "/api/users/:id", baseRps: 68, baseP50: 22, baseP95: 60, baseP99: 110, baseErrorRate: 0.5 },
+  { id: "get-orders", method: "GET", path: "/api/orders", baseRps: 51, baseP50: 55, baseP95: 140, baseP99: 220, baseErrorRate: 0.6 },
+  { id: "post-orders", method: "POST", path: "/api/orders", baseRps: 14, baseP50: 120, baseP95: 260, baseP99: 380, baseErrorRate: 1.1 },
+  { id: "get-order-items", method: "GET", path: "/api/orders/:id/items", baseRps: 29, baseP50: 40, baseP95: 100, baseP99: 170, baseErrorRate: 0.4 },
+  { id: "post-auth-login", method: "POST", path: "/api/auth/login", baseRps: 22, baseP50: 65, baseP95: 150, baseP99: 240, baseErrorRate: 1.6 },
+  { id: "get-products", method: "GET", path: "/api/products", baseRps: 88, baseP50: 18, baseP95: 45, baseP99: 80, baseErrorRate: 0.2 },
+  { id: "delete-product", method: "DELETE", path: "/api/products/:id", baseRps: 3, baseP50: 30, baseP95: 70, baseP99: 120, baseErrorRate: 0.9 },
+  { id: "get-search", method: "GET", path: "/api/search", baseRps: 35, baseP50: 90, baseP95: 220, baseP99: 340, baseErrorRate: 1.3 },
+];
+
+interface EndpointState extends EndpointConfig {
+  rps: number;
+  errorRatePct: number;
+  p50: number;
+  p95: number;
+  p99: number;
+  incidentTicksRemaining: number;
+  incidentKind: "errors" | "latency" | null;
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.max(min, Math.min(max, value));
+}
+
+function statusFor(errorRatePct: number, p99: number): EndpointStatus {
+  if (errorRatePct >= ERROR_RATE_CRITICAL_PCT || p99 >= P99_CRITICAL_MS) return "error";
+  if (errorRatePct >= ERROR_RATE_WARNING_PCT || p99 >= P99_WARNING_MS) return "degraded";
+  return "healthy";
+}
+
+export function createTrafficSimulator(seed = Date.now()) {
+  let tickIndex = 0;
+  const random = mulberry32(seed);
+  const withRandom = <T>(fn: (rand: () => number) => T) => fn(random);
+
+  const states: EndpointState[] = ENDPOINTS.map((cfg) => ({
+    ...cfg,
+    rps: cfg.baseRps,
+    errorRatePct: cfg.baseErrorRate,
+    p50: cfg.baseP50,
+    p95: cfg.baseP95,
+    p99: cfg.baseP99,
+    incidentTicksRemaining: 0,
+    incidentKind: null,
+  }));
+
+  function stepEndpoint(state: EndpointState, t: number): EndpointSnapshot {
+    const wave = Math.sin(t / 90000 + state.baseRps) * 0.12;
+    const targetRps = state.baseRps * (1 + wave);
+    state.rps = clamp(state.rps + (targetRps - state.rps) * 0.15 + withRandom((r) => (r() - 0.5) * state.baseRps * 0.08), state.baseRps * 0.35, state.baseRps * 2.2);
+
+    if (state.incidentTicksRemaining <= 0 && withRandom((r) => r()) < 0.0018) {
+      state.incidentKind = withRandom((r) => (r() < 0.5 ? "errors" : "latency"));
+      state.incidentTicksRemaining = 12 + Math.floor(withRandom((r) => r()) * 28);
+    }
+
+    const inIncident = state.incidentTicksRemaining > 0;
+    const incidentStrength = inIncident ? state.incidentTicksRemaining / 40 + 0.3 : 0;
+
+    const targetErrorRate = state.baseErrorRate + (inIncident && state.incidentKind === "errors" ? incidentStrength * 22 : 0);
+    state.errorRatePct = clamp(state.errorRatePct + (targetErrorRate - state.errorRatePct) * 0.35 + withRandom((r) => (r() - 0.5) * 0.15), 0, 45);
+
+    const latencyMultiplier = inIncident && state.incidentKind === "latency" ? 1 + incidentStrength * 2.4 : 1;
+    const jitter = () => withRandom((r) => (r() - 0.5) * 0.06);
+    state.p50 = clamp(state.p50 + (state.baseP50 * latencyMultiplier - state.p50) * 0.3 + state.baseP50 * jitter(), state.baseP50 * 0.6, state.baseP50 * 6);
+    state.p95 = clamp(state.p95 + (state.baseP95 * latencyMultiplier - state.p95) * 0.3 + state.baseP95 * jitter(), state.baseP95 * 0.6, state.baseP95 * 6);
+    state.p99 = clamp(state.p99 + (state.baseP99 * latencyMultiplier - state.p99) * 0.3 + state.baseP99 * jitter(), state.baseP99 * 0.6, state.baseP99 * 7);
+
+    if (inIncident) state.incidentTicksRemaining -= 1;
+
+    return {
+      id: state.id,
+      method: state.method,
+      path: state.path,
+      rps: state.rps,
+      errorRatePct: state.errorRatePct,
+      p50: state.p50,
+      p95: state.p95,
+      p99: state.p99,
+      status: statusFor(state.errorRatePct, state.p99),
+    };
+  }
+
+  function tick(timestamp = Date.now()): TrafficTick {
+    tickIndex += 1;
+    const endpoints = states.map((s) => stepEndpoint(s, timestamp + tickIndex));
+
+    const totalRps = endpoints.reduce((sum, e) => sum + e.rps, 0);
+    const weightedErrorRate = endpoints.reduce((sum, e) => sum + e.errorRatePct * e.rps, 0) / (totalRps || 1);
+    const weightedP50 = endpoints.reduce((sum, e) => sum + e.p50 * e.rps, 0) / (totalRps || 1);
+    const weightedP95 = endpoints.reduce((sum, e) => sum + e.p95 * e.rps, 0) / (totalRps || 1);
+    const weightedP99 = endpoints.reduce((sum, e) => sum + e.p99 * e.rps, 0) / (totalRps || 1);
+
+    const serverErrorShare = clamp(weightedErrorRate * 0.7, 0, 100) / 100;
+    const clientErrorShare = clamp(weightedErrorRate * 0.3, 0, 100) / 100;
+    const redirectShare = 0.01;
+    const okShare = clamp(1 - serverErrorShare - clientErrorShare - redirectShare, 0, 1);
+
+    return {
+      t: timestamp,
+      totalRps,
+      errorRatePct: weightedErrorRate,
+      p50: weightedP50,
+      p95: weightedP95,
+      p99: weightedP99,
+      statusBreakdown: {
+        ok: totalRps * okShare,
+        redirect: totalRps * redirectShare,
+        clientError: totalRps * clientErrorShare,
+        serverError: totalRps * serverErrorShare,
+      },
+      endpoints,
+    };
+  }
+
+  return { tick };
+}
+
+function mulberry32(seed: number) {
+  let a = seed;
+  return function () {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function seedHistory(
+  sim: ReturnType<typeof createTrafficSimulator>,
+  count: number,
+  intervalMs: number,
+  endTime = Date.now(),
+): TrafficTick[] {
+  const startTime = endTime - count * intervalMs;
+  const history: TrafficTick[] = [];
+  for (let i = 0; i < count; i += 1) {
+    history.push(sim.tick(startTime + i * intervalMs));
+  }
+  return history;
+}
