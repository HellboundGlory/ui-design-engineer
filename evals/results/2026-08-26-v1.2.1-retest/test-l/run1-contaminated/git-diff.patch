+          ))}
+        </ul>
+      }
+      className="h-[280px]"
+    >
+      <ResponsiveContainer width="100%" height="100%">
+        <AreaChart data={rows} margin={{ top: 4, right: 8, left: 0, bottom: 0 }}>
+          <defs>
+            {SERIES.map((s) => (
+              <linearGradient key={s.key} id={`fill-${s.key}`} x1="0" y1="0" x2="0" y2="1">
+                <stop offset="5%" stopColor={s.color} stopOpacity={0.5} />
+                <stop offset="95%" stopColor={s.color} stopOpacity={0.03} />
+              </linearGradient>
+            ))}
+          </defs>
+          <CartesianGrid stroke={palette.borderSubtle} strokeDasharray="3 3" vertical={false} />
+          <XAxis
+            dataKey="t"
+            tickFormatter={formatAxisTime}
+            stroke={palette.borderSubtle}
+            tick={{ fill: palette.mutedForeground, fontSize: 11, fontFamily: "var(--font-mono)" }}
+            tickLine={false}
+            axisLine={false}
+            minTickGap={48}
+          />
+          <YAxis
+            tickFormatter={(v: number) => formatRps(v)}
+            stroke={palette.borderSubtle}
+            tick={{ fill: palette.mutedForeground, fontSize: 11, fontFamily: "var(--font-mono)" }}
+            tickLine={false}
+            axisLine={false}
+            width={44}
+          />
+          <Tooltip
+            content={({ active, payload, label }) => {
+              if (!active || !payload?.length) return null;
+              return (
+                <ChartTooltipShell
+                  timestamp={label as number}
+                  rows={SERIES.map((s) => ({
+                    label: s.label,
+                    color: s.color,
+                    value: `${formatRps((payload.find((p) => p.dataKey === s.key)?.value as number) ?? 0)} req/s`,
+                  }))}
+                />
+              );
+            }}
+          />
+          {SERIES.map((s) => (
+            <Area
+              key={s.key}
+              type="monotone"
+              dataKey={s.key}
