+++ b/src/components/MetricStrip.tsx
@@ -0,0 +1,88 @@
+import { clsx } from "clsx";
+import { ArrowDown, ArrowUp } from "lucide-react";
+import type { TrafficTick } from "../lib/traffic-simulator";
+import { ERROR_RATE_WARNING_PCT, ERROR_RATE_CRITICAL_PCT } from "../lib/traffic-simulator";
+import { formatMs, formatPct, formatRps } from "../lib/format";
+
+interface MetricStripProps {
+  latest: TrafficTick | undefined;
+  previousWindowErrorRate: number;
+  activeEndpointCount: number;
+  degradedCount: number;
+}
+
+function Metric({ label, value, tone, unit }: { label: string; value: string; tone?: "success" | "warning" | "error"; unit?: string }) {
+  const toneClass = tone === "error" ? "text-status-error" : tone === "warning" ? "text-status-warning" : "text-foreground";
+  return (
+    <div className="flex flex-col gap-0.5 px-4 py-2.5">
+      <span className="text-[11px] text-muted-foreground">{label}</span>
+      <span className={clsx("num text-[20px] font-medium leading-none", toneClass)}>
+        {value}
+        {unit && <span className="ml-1 text-[12px] text-muted-foreground">{unit}</span>}
+      </span>
+    </div>
+  );
+}
+
+function GroupLabel({ children }: { children: string }) {
+  return (
+    <div className="flex items-end px-4 pb-1 pt-2">
+      <span className="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{children}</span>
+    </div>
+  );
+}
+
+export function MetricStrip({ latest, previousWindowErrorRate, activeEndpointCount, degradedCount }: MetricStripProps) {
+  const errorRate = latest?.errorRatePct ?? 0;
+  const errorDelta = errorRate - previousWindowErrorRate;
+  const errorTone = errorRate >= ERROR_RATE_CRITICAL_PCT ? "error" : errorRate >= ERROR_RATE_WARNING_PCT ? "warning" : "success";
+
+  return (
+    <div className="grid grid-cols-1 divide-y divide-border-subtle border border-border bg-surface sm:grid-cols-3 sm:divide-x sm:divide-y-0 rounded-lg">
+      <div>
+        <GroupLabel>Traffic</GroupLabel>
+        <div className="grid grid-cols-2 divide-x divide-border-subtle">
+          <Metric label="Requests / sec" value={formatRps(latest?.totalRps ?? 0)} />
+          <Metric
+            label="Active endpoints"
+            value={String(activeEndpointCount)}
+            tone={degradedCount > 0 ? "warning" : "success"}
+            unit={degradedCount > 0 ? `${degradedCount} degraded` : undefined}
+          />
+        </div>
+      </div>
+
+      <div>
+        <GroupLabel>Errors</GroupLabel>
+        <div className="grid grid-cols-2 divide-x divide-border-subtle">
+          <Metric label="Error rate" value={formatPct(errorRate)} tone={errorTone} />
+          <div className="flex flex-col gap-0.5 px-4 py-2.5">
+            <span className="text-[11px] text-muted-foreground">vs. earlier this window</span>
+            <span
+              className={clsx(
+                "num inline-flex items-center gap-1 text-[20px] font-medium leading-none",
+                errorDelta > 0.05 ? "text-status-error" : errorDelta < -0.05 ? "text-status-success" : "text-muted-foreground",
+              )}
+            >
+              {errorDelta > 0.05 ? (
+                <ArrowUp className="size-3.5" strokeWidth={2} />
+              ) : errorDelta < -0.05 ? (
+                <ArrowDown className="size-3.5" strokeWidth={2} />
+              ) : null}
+              {formatPct(Math.abs(errorDelta))}
+            </span>
+          </div>
+        </div>
+      </div>
+
+      <div>
+        <GroupLabel>Latency</GroupLabel>
+        <div className="grid grid-cols-3 divide-x divide-border-subtle">
+          <Metric label="p50" value={formatMs(latest?.p50 ?? 0)} />
+          <Metric label="p95" value={formatMs(latest?.p95 ?? 0)} />
+          <Metric label="p99" value={formatMs(latest?.p99 ?? 0)} tone={(latest?.p99 ?? 0) >= 900 ? "error" : (latest?.p99 ?? 0) >= 500 ? "warning" : "success"} />
+        </div>
+      </div>
+    </div>
+  );
+}
