+        </div>
+      </div>
+
+      <div className="flex items-center gap-3">
+        {lastUpdated && (
+          <span className="num hidden text-[11px] text-muted-foreground sm:inline">
+            updated {formatClockTime(lastUpdated)}
+          </span>
+        )}
