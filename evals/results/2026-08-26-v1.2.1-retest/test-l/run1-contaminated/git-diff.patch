+import { formatClockTime } from "../lib/format";
+
+interface TopBarProps {
+  paused: boolean;
+  onTogglePaused: () => void;
+  timeRange: TimeRangeLabel;
+  onTimeRangeChange: (range: TimeRangeLabel) => void;
+  lastUpdated: number | undefined;
+}
