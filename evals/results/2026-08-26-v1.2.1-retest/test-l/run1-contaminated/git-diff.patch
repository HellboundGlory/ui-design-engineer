+++ b/src/components/ErrorRateChart.tsx
@@ -0,0 +1,64 @@
+import { CartesianGrid, Line, LineChart, ReferenceLine, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";
+import type { TrafficTick } from "../lib/traffic-simulator";
+import { ERROR_RATE_CRITICAL_PCT } from "../lib/traffic-simulator";
+import { formatAxisTime, formatPct } from "../lib/format";
+import { palette } from "../lib/palette";
+import { ChartPanel } from "./ChartPanel";
+import { ChartTooltipShell } from "./ChartTooltip";
+
+export function ErrorRateChart({ data }: { data: TrafficTick[] }) {
+  const rows = data.map((tick) => ({ t: tick.t, errorRatePct: tick.errorRatePct }));
+
+  return (
+    <ChartPanel title="Error rate" subtitle="Share of requests returning 4xx/5xx" className="h-[240px]">
+      <ResponsiveContainer width="100%" height="100%">
+        <LineChart data={rows} margin={{ top: 4, right: 8, left: 0, bottom: 0 }}>
+          <CartesianGrid stroke={palette.borderSubtle} strokeDasharray="3 3" vertical={false} />
+          <XAxis
+            dataKey="t"
+            tickFormatter={formatAxisTime}
+            stroke={palette.borderSubtle}
+            tick={{ fill: palette.mutedForeground, fontSize: 11, fontFamily: "var(--font-mono)" }}
+            tickLine={false}
+            axisLine={false}
+            minTickGap={48}
+          />
+          <YAxis
+            tickFormatter={(v: number) => `${v}%`}
+            stroke={palette.borderSubtle}
+            tick={{ fill: palette.mutedForeground, fontSize: 11, fontFamily: "var(--font-mono)" }}
+            tickLine={false}
+            axisLine={false}
+            width={40}
+          />
+          <ReferenceLine
+            y={ERROR_RATE_CRITICAL_PCT}
+            stroke={palette.statusError}
+            strokeDasharray="4 4"
+            strokeOpacity={0.7}
+            label={{ value: `${ERROR_RATE_CRITICAL_PCT}% threshold`, position: "insideTopRight", fill: palette.statusError, fontSize: 10 }}
+          />
+          <Tooltip
+            content={({ active, payload, label }) => {
+              if (!active || !payload?.length) return null;
+              return (
+                <ChartTooltipShell
+                  timestamp={label as number}
+                  rows={[{ label: "Error rate", color: palette.statusError, value: formatPct((payload[0]?.value as number) ?? 0) }]}
+                />
+              );
+            }}
+          />
+          <Line
+            type="monotone"
+            dataKey="errorRatePct"
+            stroke={palette.statusError}
+            strokeWidth={1.75}
+            dot={false}
+            isAnimationActive={false}
+          />
+        </LineChart>
+      </ResponsiveContainer>
+    </ChartPanel>
+  );
+}
