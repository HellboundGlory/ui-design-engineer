+:root {
+  color-scheme: dark;
+
+  --bg: #0a0d13;
+  --bg-elevated: #10141c;
+  --card-bg: #131926;
+  --card-bg-hover: #161d2c;
+  --card-border: #232b3d;
+  --text-primary: #e8ecf3;
+  --text-secondary: #9aa4ba;
+  --text-muted: #66708a;
+
+  --accent: #2dd4bf;
+  --chart-accent: #2dd4bf;
+  --good: #34d399;
+  --warn: #f5a623;
+  --critical: #f2495c;
+
+  --series-p50: #4fd1c5;
+  --series-p95: #f5a623;
+  --series-p99: #f2495c;
+
+  --grid-line: #1c2333;
+  --axis-text: #6b7490;
+  --tooltip-bg: #161d2c;
+  --tooltip-border: #2a3350;
+
+  --radius-md: 10px;
+  --radius-lg: 14px;
+  --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif;
+  --font-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
+
+  font-family: var(--font-sans);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  margin: 0;
+  padding: 0;
+  background: var(--bg);
+  color: var(--text-primary);
+}
+
+body {
+  min-height: 100vh;
+}
+
+h1,
+h2,
+h3,
+p {
+  margin: 0;
+}
+
+button,
+select {
+  font-family: inherit;
+  font-size: inherit;
+  color: inherit;
+}
+
+code {
+  font-family: var(--font-mono);
+  font-size: 0.85em;
+}
+
+/* Visually hide content while keeping it available to screen readers. */
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+  border-radius: 4px;
+}
+
+/* ---------- Layout shell ---------- */
+
+.app-shell {
+  max-width: 1400px;
+  margin: 0 auto;
+  padding: 20px 24px 48px;
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+}
+
+.app-header {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding-bottom: 16px;
+  border-bottom: 1px solid var(--card-border);
+}
+
+.app-header__title-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+
+.app-header__brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.app-header__logo {
+  width: 22px;
+  height: 22px;
+  border-radius: 6px;
+  background: linear-gradient(135deg, var(--accent), #1a8f80);
+  flex-shrink: 0;
+}
+
+.app-header h1 {
+  font-size: 1.35rem;
+  font-weight: 650;
+  letter-spacing: -0.01em;
+}
+
+.app-header__subtitle {
+  color: var(--text-secondary);
+  font-size: 0.875rem;
+}
+
+.app-header__controls {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.live-indicator {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 0.8rem;
+  color: var(--text-secondary);
+  padding: 6px 10px;
+  border: 1px solid var(--card-border);
+  border-radius: 999px;
+  background: var(--card-bg);
+}
+
+.live-indicator__dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+}
+
+.live-indicator__dot.is-live {
+  background: var(--good);
+  box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.18);
+  animation: pulse 2s ease-in-out infinite;
+}
+
+.live-indicator__dot.is-paused {
+  background: var(--text-muted);
+}
+
+@keyframes pulse {
+  0%,
+  100% {
+    opacity: 1;
+  }
+  50% {
+    opacity: 0.4;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .live-indicator__dot.is-live {
+    animation: none;
+  }
+}
+
+.interval-select {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 0.8rem;
+  color: var(--text-secondary);
+}
+
+.interval-select select {
+  background: var(--card-bg);
+  border: 1px solid var(--card-border);
+  color: var(--text-primary);
+  border-radius: 8px;
+  padding: 6px 8px;
+}
+
+.pause-btn {
+  background: var(--card-bg);
+  border: 1px solid var(--card-border);
+  color: var(--text-primary);
+  border-radius: 8px;
+  padding: 7px 14px;
+  cursor: pointer;
+  font-weight: 500;
+  font-size: 0.8rem;
+}
+
+.pause-btn:hover {
+  background: var(--card-bg-hover);
+}
+
+.app-main {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+
+.app-footer {
+  color: var(--text-muted);
+  font-size: 0.78rem;
+  padding-top: 8px;
+  border-top: 1px solid var(--card-border);
+}
+
+/* ---------- KPI row ---------- */
+
+.kpi-row {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 16px;
+}
+
+@media (max-width: 1024px) {
+  .kpi-row {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (max-width: 520px) {
+  .kpi-row {
+    grid-template-columns: 1fr;
+  }
+}
+
+.kpi-card {
+  background: var(--card-bg);
+  border: 1px solid var(--card-border);
+  border-radius: var(--radius-lg);
+  padding: 16px 18px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.kpi-card__label {
+  font-size: 0.78rem;
+  color: var(--text-secondary);
+  font-weight: 500;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.kpi-card__value-row {
+  display: flex;
+  align-items: baseline;
+  gap: 4px;
+}
+
+.kpi-card__value {
+  font-size: 1.9rem;
+  font-weight: 650;
+  font-family: var(--font-mono);
+  letter-spacing: -0.02em;
+}
+
+.kpi-card__unit {
+  font-size: 0.9rem;
+  color: var(--text-secondary);
+}
+
+.kpi-card__footer {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 0.78rem;
+  min-height: 1.1em;
+}
+
+.kpi-card__delta {
+  font-family: var(--font-mono);
+  font-weight: 600;
+}
+
+.kpi-card__delta--good {
+  color: var(--good);
+}
+
+.kpi-card__delta--bad {
+  color: var(--critical);
+}
+
+.kpi-card__delta--flat {
+  color: var(--text-muted);
+}
+
+.kpi-card__hint {
+  color: var(--text-muted);
+}
+
+/* ---------- Chart cards ---------- */
+
+.chart-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 16px;
+}
+
+@media (max-width: 900px) {
+  .chart-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+.chart-card,
+.endpoint-table-card {
+  background: var(--card-bg);
+  border: 1px solid var(--card-border);
+  border-radius: var(--radius-lg);
+  padding: 18px 18px 8px;
+}
+
+.endpoint-table-card {
+  padding-bottom: 4px;
+}
+
+.chart-card__header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+  margin-bottom: 8px;
+}
+
+.chart-card__title {
+  font-size: 0.95rem;
+  font-weight: 600;
+}
+
+.chart-card__description {
+  font-size: 0.78rem;
+  color: var(--text-secondary);
+  margin-top: 2px;
+}
+
+.chart-legend {
+  display: flex;
+  gap: 12px;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  font-size: 0.78rem;
+  color: var(--text-secondary);
+}
+
+.chart-legend__item {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.chart-legend__swatch {
+  width: 10px;
+  height: 10px;
+  border-radius: 3px;
+  display: inline-block;
+}
+
+.endpoint-table-card__flag {
+  font-weight: 600;
+}
+
+.endpoint-table-card__flag--critical {
+  color: var(--critical);
+}
+
+.endpoint-table-card__flag--degraded {
+  color: var(--warn);
+}
+
+/* ---------- Status / method badges ---------- */
+
+.status-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 0.78rem;
+  font-weight: 600;
+  padding: 3px 9px;
+  border-radius: 999px;
+}
+
+.status-badge__dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+}
+
+.status-badge--healthy {
+  color: var(--good);
+  background: rgba(52, 211, 153, 0.13);
+}
+.status-badge--healthy .status-badge__dot {
+  background: var(--good);
+}
+
+.status-badge--degraded {
+  color: var(--warn);
+  background: rgba(245, 166, 35, 0.14);
+}
+.status-badge--degraded .status-badge__dot {
+  background: var(--warn);
+}
+
+.status-badge--critical {
+  color: var(--critical);
+  background: rgba(242, 73, 92, 0.16);
+}
+.status-badge--critical .status-badge__dot {
+  background: var(--critical);
+}
+
+.method-badge {
+  display: inline-block;
+  font-family: var(--font-mono);
+  font-size: 0.72rem;
+  font-weight: 700;
+  padding: 2px 6px;
+  border-radius: 5px;
+  margin-right: 8px;
+  letter-spacing: 0.02em;
+}
+
+.method-badge--get {
+  color: #7dd3fc;
+  background: rgba(125, 211, 252, 0.12);
+}
+.method-badge--post {
+  color: #34d399;
+  background: rgba(52, 211, 153, 0.12);
+}
+.method-badge--put {
+  color: #f5a623;
+  background: rgba(245, 166, 35, 0.12);
+}
+.method-badge--patch {
+  color: #c084fc;
+  background: rgba(192, 132, 252, 0.12);
+}
+.method-badge--delete {
+  color: #f2495c;
+  background: rgba(242, 73, 92, 0.12);
+}
+
+/* ---------- Endpoint table ---------- */
+
+.endpoint-table-scroll {
+  overflow-x: auto;
+}
+
+.endpoint-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.85rem;
+}
+
+.endpoint-table th,
+.endpoint-table td {
+  padding: 10px 12px;
+  text-align: left;
+  border-bottom: 1px solid var(--card-border);
+  white-space: nowrap;
+}
+
+.endpoint-table thead th {
+  color: var(--text-secondary);
+  font-size: 0.72rem;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  font-weight: 600;
+  border-bottom: 1px solid var(--card-border);
+}
+
+.endpoint-table th.is-numeric,
+.endpoint-table td.is-numeric {
+  text-align: right;
+  font-family: var(--font-mono);
+}
+
+.endpoint-table__sort-btn {
+  background: none;
+  border: none;
+  padding: 0;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  cursor: pointer;
+  color: inherit;
+  font: inherit;
+  text-transform: inherit;
+  letter-spacing: inherit;
+}
+
+.endpoint-table__sort-icon {
+  font-size: 0.6rem;
+  color: var(--accent);
+  width: 8px;
+  display: inline-block;
+}
+
+.endpoint-table__endpoint-cell {
+  font-weight: 400;
+  display: flex;
+  align-items: center;
+}
+
+.endpoint-table tbody tr:hover {
+  background: var(--card-bg-hover);
+}
+
+.is-critical-text {
+  color: var(--critical);
+  font-weight: 600;
+}
+
+.is-warn-text {
+  color: var(--warn);
+  font-weight: 600;
+}
diff --git a/src/lib/format.ts b/src/lib/format.ts
new file mode 100644
