+const { chromium } = require('playwright');
+
+async function main() {
+  const browser = await chromium.launch();
+
+  // 1. Desktop full page
+  {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    await page.screenshot({ path: '.eval/screenshots/01-desktop-full.png', fullPage: true });
+    await page.close();
+  }
+
+  // 2. Desktop hero viewport only (above the fold)
+  {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    await page.screenshot({ path: '.eval/screenshots/02-desktop-hero-viewport.png' });
+    await page.close();
+  }
+
+  // 3. Tablet full page
+  {
+    const page = await browser.newPage({ viewport: { width: 834, height: 1112 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    await page.screenshot({ path: '.eval/screenshots/03-tablet-full.png', fullPage: true });
+    await page.close();
+  }
+
+  // 4. Mobile full page
+  {
+    const page = await browser.newPage({ viewport: { width: 390, height: 844 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    await page.screenshot({ path: '.eval/screenshots/04-mobile-full.png', fullPage: true });
+    await page.close();
+  }
+
+  // 5. Gallery section close-up (desktop)
+  {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 1400 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    const gallery = await page.$('#gallery');
+    await gallery.scrollIntoViewIfNeeded();
+    await page.screenshot({ path: '.eval/screenshots/05-desktop-gallery.png', clip: await gallery.boundingBox() });
+    await page.close();
+  }
+
+  // 6. Newsletter section close-up (desktop)
+  {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    const newsletter = await page.$('#subscribe');
+    await newsletter.scrollIntoViewIfNeeded();
+    await page.screenshot({ path: '.eval/screenshots/06-desktop-newsletter.png', clip: await newsletter.boundingBox() });
+    await page.close();
+  }
+
+  // 7. Keyboard focus state check on skip link + nav
+  {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    await page.keyboard.press('Tab');
+    await page.screenshot({ path: '.eval/screenshots/07-desktop-focus-skiplink.png' });
+    await page.close();
+  }
+
+  // 8. Newsletter form submitted state
+  {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
+    await page.goto('http://localhost:4321/', { waitUntil: 'networkidle' });
+    await page.fill('#subscribe input[type=email]', 'reader@example.com');
+    await page.click('#subscribe button[type=submit]');
+    const newsletter = await page.$('#subscribe');
+    await newsletter.scrollIntoViewIfNeeded();
+    await page.screenshot({ path: '.eval/screenshots/08-desktop-newsletter-submitted.png', clip: await newsletter.boundingBox() });
+    await page.close();
+  }
+
+  await browser.close();
+  console.log('DONE');
+}
+
+main().catch((e) => {
+  console.error(e);
+  process.exit(1);
+});
