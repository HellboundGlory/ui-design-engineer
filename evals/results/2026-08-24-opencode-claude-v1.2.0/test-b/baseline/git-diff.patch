+import { chromium } from "playwright";
+
+const OUT = "/home/james/orca/workspaces/ui-design-engineer-eval-seeds/eval-test-b-baseline/.eval/screenshots";
+
+const browser = await chromium.launch();
+const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
+
+const errors = [];
+page.on("pageerror", (e) => errors.push(String(e)));
+page.on("console", (msg) => {
+  if (msg.type() === "error") errors.push(msg.text());
+});
+
+await page.goto("http://localhost:5183/logs", { waitUntil: "networkidle" });
+await page.waitForTimeout(500);
+await page.screenshot({ path: `${OUT}/01-logs-initial.png` });
+
+// Expand a row's JSON payload by clicking the first row.
+await page.locator("table tbody tr").first().click();
+await page.waitForTimeout(200);
+await page.screenshot({ path: `${OUT}/02-logs-payload-expanded.png` });
+
+// Filter to ERROR only, to check color coding + count.
+await page.getByRole("button", { name: /INFO/ }).click();
+await page.getByRole("button", { name: /WARN/ }).click();
+await page.waitForTimeout(200);
+await page.screenshot({ path: `${OUT}/03-logs-error-filter.png` });
+
+// Reset filters
+await page.getByRole("button", { name: /INFO/ }).click();
+await page.getByRole("button", { name: /WARN/ }).click();
+
+// Search
+await page.keyboard.press("/");
+await page.keyboard.type("timeout");
+await page.waitForTimeout(200);
+await page.screenshot({ path: `${OUT}/04-logs-search.png` });
+await page.keyboard.press("Escape");
+await page.waitForTimeout(100);
+
+// Clear search field content properly (Escape blurs but may leave text)
+await page.fill('input[aria-label="Search logs"]', "");
+await page.waitForTimeout(100);
+
+// Keyboard nav: focus body, press j a few times, then Enter to expand
+await page.locator("body").click({ position: { x: 5, y: 5 } });
+await page.keyboard.press("j");
+await page.keyboard.press("j");
+await page.keyboard.press("j");
+await page.waitForTimeout(100);
+await page.screenshot({ path: `${OUT}/05-logs-keyboard-selection.png` });
+await page.keyboard.press("Enter");
+await page.waitForTimeout(150);
+await page.screenshot({ path: `${OUT}/06-logs-keyboard-expand.png` });
+
+// Pause via keyboard shortcut 'p'
+await page.keyboard.press("p");
+await page.waitForTimeout(100);
+await page.screenshot({ path: `${OUT}/07-logs-paused.png` });
+
+// Shortcuts modal via '?'
+await page.keyboard.press("?");
+await page.waitForTimeout(150);
+await page.screenshot({ path: `${OUT}/08-logs-shortcuts-modal.png` });
+await page.keyboard.press("Escape");
+await page.waitForTimeout(100);
+
+// Also check Dashboard/Billing pages for visual consistency comparison
+await page.goto("http://localhost:5183/", { waitUntil: "networkidle" });
+await page.waitForTimeout(200);
+await page.screenshot({ path: `${OUT}/09-dashboard-for-comparison.png` });
+
+console.log("CONSOLE_ERRORS:", JSON.stringify(errors));
+
+await browser.close();
