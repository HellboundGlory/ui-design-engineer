diff --git a/src/pages/Logs.tsx b/src/pages/Logs.tsx
new file mode 100644
index 0000000..4253f32
--- /dev/null
+++ b/src/pages/Logs.tsx
@@ -0,0 +1,351 @@
+import { Fragment, useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Card, CardBody, CardHeader } from "../components/Card";
+import { Badge } from "../components/Badge";
+import { Button } from "../components/Button";
+import { Input } from "../components/Input";
+import { JsonTree } from "../components/log-panel/JsonTree";
+import { ShortcutsModal } from "../components/log-panel/ShortcutsModal";
+import { generateBacklog, generateLogEntry, type LogEntry, type Severity } from "../lib/logs";
+
+const MAX_LOGS = 400;
+const SEVERITIES: Severity[] = ["INFO", "WARN", "ERROR"];
+
+const severityTone: Record<Severity, "info" | "warning" | "danger"> = {
+  INFO: "info",
+  WARN: "warning",
+  ERROR: "danger",
+};
+
+const severityDot: Record<Severity, string> = {
+  INFO: "bg-accent",
+  WARN: "bg-warning",
+  ERROR: "bg-danger",
+};
+
+function formatTime(ts: number): string {
+  const d = new Date(ts);
+  return d.toLocaleTimeString(undefined, { hour12: false }) + "." + String(d.getMilliseconds()).padStart(3, "0");
+}
+
+function isTypingTarget(el: EventTarget | null): boolean {
+  if (!(el instanceof HTMLElement)) return false;
+  return el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable;
+}
+
+export function Logs() {
+  const [logs, setLogs] = useState<LogEntry[]>(() => generateBacklog(60));
+  const [paused, setPaused] = useState(false);
+  const [query, setQuery] = useState("");
+  const [activeSeverities, setActiveSeverities] = useState<Set<Severity>>(
+    () => new Set(SEVERITIES),
+  );
+  const [expandedIds, setExpandedIds] = useState<Set<string>>(new Set());
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const [shortcutsOpen, setShortcutsOpen] = useState(false);
+
+  const searchRef = useRef<HTMLInputElement>(null);
+  const rowRefs = useRef<Map<string, HTMLTableRowElement>>(new Map());
+
+  // Simulated live stream.
+  useEffect(() => {
+    if (paused) return;
+    const interval = window.setInterval(
+      () => {
+        setLogs((prev) => {
+          const next = [generateLogEntry(), ...prev];
+          return next.length > MAX_LOGS ? next.slice(0, MAX_LOGS) : next;
+        });
+      },
+      600 + Math.random() * 900,
+    );
+    return () => window.clearInterval(interval);
+  }, [paused, logs.length]);
+
+  const filtered = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    return logs.filter((log) => {
+      if (!activeSeverities.has(log.severity)) return false;
+      if (!q) return true;
+      return (
+        log.message.toLowerCase().includes(q) ||
+        log.service.toLowerCase().includes(q) ||
+        log.severity.toLowerCase().includes(q)
+      );
+    });
+  }, [logs, query, activeSeverities]);
+
+  const counts = useMemo(() => {
+    const c: Record<Severity, number> = { INFO: 0, WARN: 0, ERROR: 0 };
+    for (const log of logs) c[log.severity] += 1;
+    return c;
+  }, [logs]);
+
+  function toggleSeverity(sev: Severity) {
+    setActiveSeverities((prev) => {
+      const next = new Set(prev);
+      if (next.has(sev)) {
+        if (next.size === 1) return prev; // keep at least one filter active
+        next.delete(sev);
+      } else {
+        next.add(sev);
+      }
+      return next;
+    });
+  }
+
+  function toggleExpand(id: string) {
+    setExpandedIds((prev) => {
+      const next = new Set(prev);
+      if (next.has(id)) next.delete(id);
+      else next.add(id);
+      return next;
+    });
+  }
+
+  const moveSelection = useCallback(
+    (delta: number) => {
+      if (filtered.length === 0) return;
+      const currentIndex = selectedId ? filtered.findIndex((l) => l.id === selectedId) : -1;
+      const nextIndex =
+        currentIndex === -1
+          ? delta > 0
+            ? 0
+            : filtered.length - 1
+          : Math.min(Math.max(currentIndex + delta, 0), filtered.length - 1);
+      const nextId = filtered[nextIndex]?.id ?? null;
+      setSelectedId(nextId);
+      if (nextId) {
+        rowRefs.current.get(nextId)?.scrollIntoView({ block: "nearest" });
+      }
+    },
+    [filtered, selectedId],
+  );
+
+  useEffect(() => {
+    function onKeyDown(e: KeyboardEvent) {
+      if (isTypingTarget(e.target)) {
+        if (e.key === "Escape") {
+          (e.target as HTMLElement).blur();
+        }
+        return;
+      }
+
+      if (shortcutsOpen) {
+        return; // Modal owns Escape while open.
+      }
+
+      switch (e.key) {
+        case "/":
+          e.preventDefault();
+          searchRef.current?.focus();
+          break;
+        case "j":
+        case "ArrowDown":
+          e.preventDefault();
+          moveSelection(1);
+          break;
+        case "k":
+        case "ArrowUp":
+          e.preventDefault();
+          moveSelection(-1);
+          break;
+        case "Enter":
+        case "o":
+          if (selectedId) toggleExpand(selectedId);
+          break;
+        case "1":
+          toggleSeverity("INFO");
+          break;
+        case "2":
+          toggleSeverity("WARN");
+          break;
+        case "3":
+          toggleSeverity("ERROR");
+          break;
+        case "p":
+          setPaused((p) => !p);
+          break;
+        case "c":
+          setLogs([]);
+          break;
+        case "?":
+          setShortcutsOpen(true);
+          break;
+        case "Escape":
+          setSelectedId(null);
+          break;
+        default:
+          break;
+      }
+    }
+
+    window.addEventListener("keydown", onKeyDown);
+    return () => window.removeEventListener("keydown", onKeyDown);
+  }, [selectedId, filtered, shortcutsOpen, moveSelection]);
+
+  async function copyPayload(log: LogEntry) {
+    try {
+      await navigator.clipboard.writeText(JSON.stringify(log.payload, null, 2));
+    } catch {
+      // Clipboard API unavailable (e.g. insecure context) — silently ignore.
+    }
+  }
+
+  return (
+    <div className="mx-auto max-w-6xl px-6 py-6">
+      <div className="mb-5 flex items-center justify-between">
+        <div>
+          <h1 className="text-lg font-semibold text-text">Logs</h1>
+          <p className="mt-0.5 text-xs text-text-muted">
+            Live stream across all services · {logs.length} buffered
+          </p>
+        </div>
+        <div className="flex items-center gap-2">
+          <span className="flex items-center gap-1.5 text-xs text-text-muted">
+            <span
+              className={`h-1.5 w-1.5 rounded-full ${paused ? "bg-text-faint" : "bg-success"}`}
+              aria-hidden="true"
+            />
+            {paused ? "Paused" : "Live"}
+          </span>
+          <Button size="sm" variant="secondary" onClick={() => setPaused((p) => !p)}>
+            {paused ? "Resume" : "Pause"}
+          </Button>
+          <Button size="sm" variant="ghost" onClick={() => setLogs([])}>
+            Clear
+          </Button>
+          <Button size="sm" variant="ghost" onClick={() => setShortcutsOpen(true)} aria-label="Keyboard shortcuts">
+            <kbd className="rounded-sm border border-border-strong px-1 font-mono text-[10px] text-text-muted">
+              ?
+            </kbd>
+          </Button>
+        </div>
+      </div>
+
+      <div className="mb-3 flex items-center gap-2">
+        <div className="relative w-72">
+          <Input
+            ref={searchRef}
+            value={query}
+            onChange={(e) => setQuery(e.target.value)}
+            placeholder="Search message or service…"
+            aria-label="Search logs"
+          />
+          <kbd className="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 rounded-sm border border-border-strong px-1 font-mono text-[10px] text-text-faint">
+            /
+          </kbd>
+        </div>
+
+        <div className="flex items-center gap-1.5">
+          {SEVERITIES.map((sev) => {
+            const active = activeSeverities.has(sev);
+            return (
+              <button
+                key={sev}
+                type="button"
+                onClick={() => toggleSeverity(sev)}
+                aria-pressed={active}
+                className={`inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1.5 text-xs font-medium transition-colors ${
+                  active
+                    ? sev === "INFO"
+                      ? "border-accent-muted bg-accent-muted text-accent-strong"
+                      : sev === "WARN"
+                        ? "border-warning-muted bg-warning-muted text-warning"
+                        : "border-danger-muted bg-danger-muted text-danger"
+                    : "border-border text-text-faint hover:border-border-strong hover:text-text-muted"
+                }`}
+              >
+                <span className={`h-1.5 w-1.5 rounded-full ${active ? severityDot[sev] : "bg-text-faint"}`} />
+                {sev}
+                <span className="tabular text-text-faint">{counts[sev]}</span>
+              </button>
+            );
+          })}
+        </div>
+      </div>
+
+      <Card>
+        <CardHeader
+          title={`${filtered.length} of ${logs.length} logs`}
+          action={
+            <span className="text-xs text-text-faint">
+              <kbd className="rounded-sm border border-border-strong px-1 font-mono text-[10px]">j</kbd>{" "}
+              <kbd className="rounded-sm border border-border-strong px-1 font-mono text-[10px]">k</kbd> navigate ·{" "}
+              <kbd className="rounded-sm border border-border-strong px-1 font-mono text-[10px]">↵</kbd> expand
+            </span>
+          }
+        />
+        <CardBody className="p-0">
+          {filtered.length === 0 ? (
+            <div className="px-4 py-10 text-center text-sm text-text-muted">
+              No logs match the current filters.
+            </div>
+          ) : (
+            <div className="max-h-[560px] overflow-y-auto">
+              <table className="w-full text-sm">
+                <thead className="sticky top-0 z-10 bg-bg-raised">
+                  <tr className="border-b border-border text-left text-xs text-text-muted">
+                    <th className="w-28 px-4 py-2 font-medium">Time</th>
+                    <th className="w-20 px-2 py-2 font-medium">Level</th>
+                    <th className="w-40 px-2 py-2 font-medium">Service</th>
+                    <th className="px-2 py-2 font-medium">Message</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {filtered.map((log) => {
+                    const isSelected = log.id === selectedId;
+                    const isExpanded = expandedIds.has(log.id);
+                    return (
+                      <Fragment key={log.id}>
+                        <tr
+                          ref={(el) => {
+                            if (el) rowRefs.current.set(log.id, el);
+                            else rowRefs.current.delete(log.id);
+                          }}
+                          onClick={() => {
+                            setSelectedId(log.id);
+                            toggleExpand(log.id);
+                          }}
+                          className={`cursor-pointer border-b border-border last:border-0 ${
+                            isSelected ? "bg-accent-muted/40" : "hover:bg-bg-sunken"
+                          }`}
+                        >
+                          <td className="tabular px-4 py-2 text-xs text-text-faint">{formatTime(log.ts)}</td>
+                          <td className="px-2 py-2">
+                            <Badge tone={severityTone[log.severity]}>{log.severity}</Badge>
+                          </td>
+                          <td className="px-2 py-2 font-mono text-xs text-text-muted">{log.service}</td>
+                          <td className="px-2 py-2 text-text">
+                            <span className="mr-1.5 inline-block w-3 select-none text-text-faint">
+                              {isExpanded ? "▾" : "▸"}
+                            </span>
+                            {log.message}
+                          </td>
+                        </tr>
+                        {isExpanded && (
+                          <tr className="border-b border-border last:border-0">
+                            <td colSpan={4} className="bg-bg px-4 py-3">
+                              <div className="mb-2 flex items-center justify-between">
+                                <span className="text-xs font-medium text-text-muted">Payload</span>
+                                <Button size="sm" variant="ghost" onClick={() => copyPayload(log)}>
+                                  Copy JSON
+                                </Button>
+                              </div>
+                              <JsonTree data={log.payload} />
+                            </td>
+                          </tr>
+                        )}
+                      </Fragment>
+                    );
+                  })}
+                </tbody>
+              </table>
+            </div>
+          )}
+        </CardBody>
+      </Card>
+
+      <ShortcutsModal open={shortcutsOpen} onClose={() => setShortcutsOpen(false)} />
+    </div>
+  );
+}
