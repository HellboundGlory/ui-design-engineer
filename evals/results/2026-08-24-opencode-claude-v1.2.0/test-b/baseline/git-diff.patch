+import { Modal } from "../Modal";
+
+const SHORTCUTS: Array<{ keys: string[]; description: string }> = [
+  { keys: ["/"], description: "Focus search" },
+  { keys: ["j", "↓"], description: "Select next log" },
+  { keys: ["k", "↑"], description: "Select previous log" },
+  { keys: ["Enter", "o"], description: "Expand / collapse selected payload" },
+  { keys: ["1"], description: "Toggle INFO filter" },
+  { keys: ["2"], description: "Toggle WARN filter" },
+  { keys: ["3"], description: "Toggle ERROR filter" },
+  { keys: ["p"], description: "Pause / resume stream" },
+  { keys: ["c"], description: "Clear log buffer" },
+  { keys: ["Esc"], description: "Clear selection / blur search" },
+  { keys: ["?"], description: "Toggle this shortcuts panel" },
+];
+
+function Kbd({ children }: { children: string }) {
+  return (
+    <kbd className="inline-flex h-5 min-w-5 items-center justify-center rounded-sm border border-border-strong bg-bg-sunken px-1 font-mono text-[11px] text-text-muted">
+      {children}
+    </kbd>
+  );
+}
+
+export function ShortcutsModal({ open, onClose }: { open: boolean; onClose: () => void }) {
+  return (
+    <Modal open={open} onClose={onClose} title="Keyboard shortcuts">
+      <ul className="flex flex-col gap-2.5">
+        {SHORTCUTS.map((s) => (
+          <li key={s.description} className="flex items-center justify-between gap-4 text-sm">
+            <span className="text-text-muted">{s.description}</span>
+            <span className="flex shrink-0 gap-1">
+              {s.keys.map((k) => (
+                <Kbd key={k}>{k}</Kbd>
+              ))}
+            </span>
+          </li>
+        ))}
+      </ul>
+    </Modal>
+  );
+}
diff --git a/src/lib/logs.ts b/src/lib/logs.ts
new file mode 100644
index 0000000..b8cdb07
--- /dev/null
+++ b/src/lib/logs.ts
@@ -0,0 +1,143 @@
+export type Severity = "INFO" | "WARN" | "ERROR";
+
+export interface LogEntry {
+  id: string;
+  ts: number;
+  severity: Severity;
+  service: string;
+  message: string;
+  payload: Record<string, unknown>;
+}
+
+const SERVICES = [
+  "api-gateway",
+  "auth-service",
+  "billing-worker",
+  "ingest-pipeline",
+  "webhook-dispatcher",
+] as const;
+
+const ROUTES = [
+  "/v1/accounts",
+  "/v1/sessions",
+  "/v1/invoices",
+  "/v1/events/ingest",
+  "/v1/webhooks/deliver",
+  "/v1/usage/rollup",
+];
+
+let seq = 0;
+
+function rand<T>(arr: readonly T[]): T {
+  return arr[Math.floor(Math.random() * arr.length)];
+}
+
+function randInt(min: number, max: number): number {
+  return Math.floor(Math.random() * (max - min + 1)) + min;
+}
+
+function makeId(): string {
+  seq += 1;
+  return `log_${Date.now().toString(36)}_${seq}`;
+}
+
+const INFO_TEMPLATES = [
+  (route: string) => `request completed ${route}`,
+  () => "cache warm succeeded",
+  () => "connection pool resized",
+  (route: string) => `webhook delivered ${route}`,
+  () => "background job finished",
+];
+
+const WARN_TEMPLATES = [
+  () => "connection pool nearing capacity",
+  (route: string) => `retrying request ${route}`,
+  () => "rate limit threshold approaching",
+  () => "slow query detected",
+  () => "deprecated API version in use",
+];
+
+const ERROR_TEMPLATES = [
+  (route: string) => `request failed ${route}`,
+  () => "upstream timeout",
+  () => "database connection refused",
+  () => "unhandled exception in worker",
+  () => "webhook delivery failed after retries",
+];
+
+function buildMessage(severity: Severity, route: string): string {
+  const templates =
+    severity === "INFO" ? INFO_TEMPLATES : severity === "WARN" ? WARN_TEMPLATES : ERROR_TEMPLATES;
+  return rand(templates)(route);
+}
+
+function buildPayload(severity: Severity, service: string, route: string): Record<string, unknown> {
+  const base: Record<string, unknown> = {
+    requestId: `req_${Math.random().toString(36).slice(2, 10)}`,
+    service,
+    route,
+    method: rand(["GET", "POST", "PUT", "DELETE"]),
+    latencyMs: randInt(4, severity === "ERROR" ? 4200 : 380),
+    statusCode:
+      severity === "ERROR"
+        ? rand([500, 502, 503, 504])
+        : severity === "WARN"
+          ? rand([200, 429])
+          : rand([200, 201, 204]),
+    region: rand(["us-east-1", "us-west-2", "eu-central-1"]),
+    metadata: {
+      userAgent: rand(["orbitctl-cli/2.4.1", "orbitctl-sdk-js/1.9.0", "curl/8.4.0"]),
+      retryCount: severity === "INFO" ? 0 : randInt(0, 3),
+      traceId: `trace_${Math.random().toString(36).slice(2, 12)}`,
+    },
+  };
+
+  if (severity === "ERROR") {
+    base.error = {
+      type: rand(["TimeoutError", "ConnectionRefusedError", "UnhandledPromiseRejection", "ValidationError"]),
+      message: "operation did not complete within the allotted time",
+      stack: [
+        `at handler (${service}/index.ts:${randInt(10, 400)}:${randInt(1, 60)})`,
+        `at process._tickCallback (internal/process/next_tick.js:${randInt(60, 120)}:9)`,
+      ],
+    };
+  }
+
+  if (severity === "WARN") {
+    base.threshold = {
+      current: randInt(70, 95),
+      limit: 100,
+      unit: "percent",
+    };
+  }
+
+  return base;
+}
+
+export function generateLogEntry(now: number = Date.now()): LogEntry {
+  const severity: Severity = (() => {
+    const r = Math.random();
+    if (r < 0.68) return "INFO";
+    if (r < 0.92) return "WARN";
+    return "ERROR";
+  })();
+  const service = rand(SERVICES);
+  const route = rand(ROUTES);
+
+  return {
+    id: makeId(),
+    ts: now,
+    severity,
+    service,
+    message: buildMessage(severity, route),
+    payload: buildPayload(severity, service, route),
+  };
+}
+
+export function generateBacklog(count: number, endTs: number = Date.now()): LogEntry[] {
+  const entries: LogEntry[] = [];
+  for (let i = count - 1; i >= 0; i -= 1) {
+    entries.push(generateLogEntry(endTs - i * randInt(600, 1400)));
+  }
+  return entries.sort((a, b) => b.ts - a.ts);
+}
