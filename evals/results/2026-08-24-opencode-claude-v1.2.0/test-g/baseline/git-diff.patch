+++ b/src/pages/Servers.tsx
@@ -0,0 +1,229 @@
+import { useState, type FormEvent } from "react";
+import { Card, CardHeader, CardBody } from "../components/Card";
+import { Button } from "../components/Button";
+import { Badge } from "../components/Badge";
+import { Modal } from "../components/Modal";
+import { Input, Label, Select, Textarea, Checkbox } from "../components/Input";
+
+type ServerStatus = "up" | "down";
+
+type Server = {
+  id: string;
+  name: string;
+  region: string;
+  status: ServerStatus;
+  cpu: string;
+  mem: string;
+};
+
+const REGIONS = ["us-east", "eu-west", "ap-south"] as const;
+
+const initialServers: Server[] = [
+  { id: "edge-01", name: "edge-01", region: "us-east", status: "up", cpu: "42%", mem: "3.1GB" },
+  { id: "edge-02", name: "edge-02", region: "us-east", status: "up", cpu: "81%", mem: "7.4GB" },
+  { id: "edge-03", name: "edge-03", region: "eu-west", status: "down", cpu: "0%", mem: "0GB" },
+  { id: "edge-04", name: "edge-04", region: "ap-south", status: "up", cpu: "63%", mem: "5.0GB" },
+];
+
+export function Servers() {
+  const [servers, setServers] = useState<Server[]>(initialServers);
+  const [modalMode, setModalMode] = useState<"add" | "edit" | null>(null);
+  const [editingServer, setEditingServer] = useState<Server | null>(null);
+
+  function openAdd() {
+    setEditingServer(null);
+    setModalMode("add");
+  }
+
+  function openEdit(server: Server) {
+    setEditingServer(server);
+    setModalMode("edit");
+  }
+
+  function closeModal() {
+    setModalMode(null);
+    setEditingServer(null);
+  }
+
+  function handleSubmit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const form = e.currentTarget;
+    const data = new FormData(form);
+    const name = String(data.get("name") ?? "").trim();
+    const region = String(data.get("region") ?? REGIONS[0]);
+
+    if (!name) return;
+
+    if (modalMode === "edit" && editingServer) {
+      setServers((prev) =>
+        prev.map((s) => (s.id === editingServer.id ? { ...s, name, region } : s)),
+      );
+    } else {
+      setServers((prev) => [
+        ...prev,
+        {
+          id:
+            typeof crypto !== "undefined" && "randomUUID" in crypto
+              ? crypto.randomUUID()
+              : `server-${prev.length}-${Date.now()}`,
+          name,
+          region,
+          status: "up",
+          cpu: "—",
+          mem: "—",
+        },
+      ]);
+    }
+
+    closeModal();
+  }
+
+  const editing = modalMode === "edit" ? editingServer : null;
+
+  return (
+    <div className="mx-auto max-w-5xl px-6 py-6">
+      <h1 className="mb-5 text-lg font-semibold text-text">Servers</h1>
+
+      <Card>
+        <CardHeader
+          title="Server inventory"
+          action={
+            <Button size="sm" variant="primary" onClick={openAdd}>
+              Add server
+            </Button>
+          }
+        />
+        <CardBody className="p-0">
+          <table className="w-full text-sm">
+            <caption className="sr-only">
+              Server inventory: name, region, status, CPU and memory usage, and available
+              actions
+            </caption>
+            <thead>
+              <tr className="border-b border-border text-left text-xs text-text-muted">
+                <th scope="col" className="px-4 py-2 font-medium">
+                  Name
+                </th>
+                <th scope="col" className="px-4 py-2 font-medium">
+                  Region
+                </th>
+                <th scope="col" className="px-4 py-2 font-medium">
+                  Status
+                </th>
+                <th scope="col" className="px-4 py-2 text-right font-medium">
+                  CPU
+                </th>
+                <th scope="col" className="px-4 py-2 text-right font-medium">
+                  Memory
+                </th>
+                <th scope="col" className="px-4 py-2 font-medium">
+                  <span className="sr-only">Actions</span>
+                </th>
+              </tr>
+            </thead>
+            <tbody>
+              {servers.map((server) => (
+                <tr key={server.id} className="border-b border-border last:border-0">
+                  <td className="px-4 py-2.5 font-mono text-text">{server.name}</td>
+                  <td className="px-4 py-2.5 text-text-muted">{server.region}</td>
+                  <td className="px-4 py-2.5">
+                    <Badge tone={server.status === "up" ? "success" : "danger"}>
+                      {server.status}
+                    </Badge>
+                  </td>
+                  <td className="tabular px-4 py-2.5 text-right text-text">{server.cpu}</td>
+                  <td className="tabular px-4 py-2.5 text-right text-text">{server.mem}</td>
+                  <td className="px-4 py-2.5 text-right">
+                    <Button size="sm" variant="ghost" onClick={() => openEdit(server)}>
+                      Edit<span className="sr-only"> {server.name}</span>
+                    </Button>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </CardBody>
+      </Card>
+
+      <Modal
+        open={modalMode !== null}
+        onClose={closeModal}
+        title={editing ? `Edit ${editing.name}` : "Add server"}
+        footer={
+          <>
+            <Button type="button" variant="ghost" onClick={closeModal}>
+              Cancel
+            </Button>
+            <Button type="submit" form="server-form" variant="primary">
+              {editing ? "Save changes" : "Add server"}
+            </Button>
+          </>
+        }
+      >
+        <form id="server-form" key={editing ? editing.id : "add"} onSubmit={handleSubmit}>
+          <p className="mb-3 text-xs text-text-muted">Fields marked * are required.</p>
+
+          <div className="mb-3">
+            <Label htmlFor="server-name">Name *</Label>
+            <Input
+              id="server-name"
+              name="name"
+              type="text"
+              required
+              aria-required="true"
+              defaultValue={editing ? editing.name : ""}
+              placeholder="edge-05"
+            />
+          </div>
+
+          <div className="mb-3">
+            <Label htmlFor="server-region">Region *</Label>
+            <Select
+              id="server-region"
+              name="region"
+              required
+              aria-required="true"
+              defaultValue={editing ? editing.region : REGIONS[0]}
+            >
+              {REGIONS.map((region) => (
+                <option key={region} value={region}>
+                  {region}
+                </option>
+              ))}
+            </Select>
+          </div>
+
+          <div className="mb-3">
+            <Label htmlFor="server-ip">IP address *</Label>
+            <Input
+              id="server-ip"
+              name="ip"
+              type="text"
+              required
+              aria-required="true"
+              pattern="^(\d{1,3}\.){3}\d{1,3}$"
+              aria-describedby="server-ip-hint"
+              placeholder="10.0.4.12"
+            />
+            <p id="server-ip-hint" className="mt-1 text-xs text-text-muted">
+              IPv4 dotted-decimal format, e.g. 10.0.4.12
+            </p>
+          </div>
+
+          <fieldset className="mb-3">
+            <legend className="mb-1.5 text-xs font-medium text-text-muted">Options</legend>
+            <div className="flex flex-col gap-2">
+              <Checkbox id="server-active" name="active" label="Active" />
+              <Checkbox id="server-monitor" name="monitor" label="Enable monitoring" />
+            </div>
+          </fieldset>
+
+          <div>
+            <Label htmlFor="server-notes">Notes</Label>
+            <Textarea id="server-notes" name="notes" rows={3} />
+          </div>
+        </form>
+      </Modal>
+    </div>
+  );
+}
