+import { chromium } from "playwright";
+import AxeBuilder from "@axe-core/playwright";
+import fs from "node:fs";
+
+const base = "http://localhost:5183";
+const shotDir =
+  "/home/james/orca/workspaces/ui-design-engineer-eval-seeds/eval-test-g-baseline/.eval/screenshots";
+fs.mkdirSync(shotDir, { recursive: true });
+
+const browser = await chromium.launch();
+const context = await browser.newContext({ viewport: { width: 1280, height: 900 } });
+const page = await context.newPage();
+
+const results = {};
+
+// 1. Servers page default view
+await page.goto(`${base}/servers`, { waitUntil: "networkidle" });
+await page.screenshot({ path: `${shotDir}/01-servers-page.png` });
+
+let axe = await new AxeBuilder({ page }).analyze();
+results["servers-page"] = axe.violations.map((v) => ({ id: v.id, impact: v.impact, nodes: v.nodes.length }));
+
+// 2. Open Add Server modal
+await page.getByRole("button", { name: "Add server" }).click();
+await page.waitForTimeout(150);
+await page.screenshot({ path: `${shotDir}/02-add-server-modal.png` });
+
+axe = await new AxeBuilder({ page }).analyze();
+results["add-modal"] = axe.violations.map((v) => ({ id: v.id, impact: v.impact, nodes: v.nodes.length }));
+
+// 3. Trigger native validation (submit empty required fields)
+await page.getByRole("button", { name: "Add server" }).nth(1).click().catch(() => {});
+await page.waitForTimeout(150);
+await page.screenshot({ path: `${shotDir}/03-add-server-validation.png` });
+
+// close modal, open edit
+await page.keyboard.press("Escape");
+await page.waitForTimeout(150);
+await page.getByRole("button", { name: /Edit edge-01/ }).click();
+await page.waitForTimeout(150);
+await page.screenshot({ path: `${shotDir}/04-edit-server-modal.png` });
+
+axe = await new AxeBuilder({ page }).analyze();
+results["edit-modal"] = axe.violations.map((v) => ({ id: v.id, impact: v.impact, nodes: v.nodes.length }));
+
+await page.keyboard.press("Escape");
+
+// 4. Dashboard for comparison (tokens/visual consistency)
+await page.goto(`${base}/`, { waitUntil: "networkidle" });
+await page.screenshot({ path: `${shotDir}/05-dashboard-for-reference.png` });
+
+await browser.close();
+
+fs.writeFileSync(
+  "/tmp/axe-results.json",
+  JSON.stringify(results, null, 2),
+);
+console.log(JSON.stringify(results, null, 2));
