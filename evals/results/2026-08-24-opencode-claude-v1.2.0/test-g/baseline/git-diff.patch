+  return (
+    <textarea
+      className={`w-full rounded-md border border-border bg-bg-sunken px-3 py-2 text-sm text-text placeholder:text-text-faint focus:border-accent ${className}`}
+      {...props}
+    />
+  );
+}
+
+export function Checkbox({
+  id,
+  label,
+  className = "",
+  ...props
+}: InputHTMLAttributes<HTMLInputElement> & { id: string; label: string }) {
+  return (
+    <label htmlFor={id} className="flex items-center gap-2 text-sm text-text">
+      <input
+        id={id}
+        type="checkbox"
+        className={`h-4 w-4 rounded-sm border border-border-strong bg-bg-sunken accent-accent ${className}`}
+        {...props}
+      />
+      {label}
+    </label>
+  );
+}
