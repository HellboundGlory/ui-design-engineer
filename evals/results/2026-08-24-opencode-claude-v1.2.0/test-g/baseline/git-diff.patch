@@ -0,0 +1,32 @@
+import { chromium } from "playwright";
+import AxeBuilder from "@axe-core/playwright";
+
+const base = "http://localhost:5183";
+const browser = await chromium.launch();
+const context = await browser.newContext({ viewport: { width: 1280, height: 900 } });
+const page = await context.newPage();
+
+async function report(label, url, afterNav) {
+  await page.goto(url, { waitUntil: "networkidle" });
+  if (afterNav) await afterNav();
+  const axe = await new AxeBuilder({ page }).analyze();
+  console.log(`\n=== ${label} ===`);
+  for (const v of axe.violations) {
+    console.log(`- ${v.id} (${v.impact}): ${v.help}`);
+    for (const n of v.nodes) {
+      console.log(`    target: ${n.target.join(" ")}`);
+      console.log(`    summary: ${n.failureSummary?.split("\n").join(" | ")}`);
+    }
+  }
+  if (axe.violations.length === 0) console.log("  (none)");
+}
+
+await report("Dashboard (existing page, baseline)", `${base}/`);
+await report("Billing (existing page, baseline)", `${base}/billing`);
+await report("Servers (new page)", `${base}/servers`);
+await report("Servers - Add modal open", `${base}/servers`, async () => {
+  await page.getByRole("button", { name: "Add server" }).click();
+  await page.waitForTimeout(150);
+});
+
+await browser.close();
