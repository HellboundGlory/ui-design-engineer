+import { Card, CardBody } from "../components/Card";
+import { Badge } from "../components/Badge";
+
+type IncidentStatus = "investigating" | "resolved";
+
+const statusMeta: Record<IncidentStatus, { label: string; tone: "warning" | "success" }> = {
+  investigating: { label: "Investigating", tone: "warning" },
+  resolved: { label: "Resolved", tone: "success" },
+};
+
+const incidents = [
+  {
+    id: "INC-0512",
+    title: "api-gateway — p99 latency spike",
+    meta: "latency-monitor · waiting 22m",
+    status: "investigating" as IncidentStatus,
+  },
+  {
+    id: "INC-0509",
+    title: "billing-worker — elevated error rate",
+    meta: "error-budget-alert · waiting 6m",
+    status: "investigating" as IncidentStatus,
+  },
+  {
+    id: "INC-0498",
+    title: "auth-service — cert rotation reminder",
+    meta: "cert-watcher · resolved 3h ago",
+    status: "resolved" as IncidentStatus,
+  },
+  {
+    id: "INC-0487",
+    title: "ingest-pipeline — disk usage warning",
+    meta: "disk-monitor · resolved 1d ago",
+    status: "resolved" as IncidentStatus,
+  },
+];
+
+const stats = [
+  { label: "Avg. time to ack", value: "6m", sub: "last 24h" },
+  { label: "Open incidents", value: "2", sub: "1 unassigned" },
+];
+
+export function Incidents() {
+  return (
+    <div className="mx-auto max-w-5xl px-6 py-6">
+      <div className="mb-5">
+        <h1 className="text-lg font-semibold text-text">Incident queue</h1>
+        <p className="mt-0.5 text-xs text-text-muted">orbitctl — Platform Ops</p>
+      </div>
+
+      <div className="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_280px]">
+        <Card>
+          <CardBody className="p-0">
+            <ul>
+              {incidents.map((incident) => {
+                const meta = statusMeta[incident.status];
+                return (
+                  <li
+                    key={incident.id}
+                    className="flex flex-col gap-1.5 border-b border-border px-4 py-3 last:border-0 sm:flex-row sm:items-center sm:justify-between sm:gap-3"
+                  >
+                    <div className="min-w-0">
+                      <div className="truncate text-sm font-medium text-text">
+                        {incident.title}
+                      </div>
+                      <div className="mt-0.5 truncate text-xs text-text-muted">
+                        {incident.meta}
+                      </div>
+                    </div>
+                    <Badge tone={meta.tone}>{meta.label}</Badge>
+                  </li>
+                );
+              })}
+            </ul>
+          </CardBody>
+        </Card>
+
+        <div className="flex flex-col gap-4">
+          {stats.map((s) => (
+            <Card key={s.label} className="px-4 py-3.5">
+              <div className="text-[11px] font-medium uppercase tracking-wide text-text-muted">
+                {s.label}
+              </div>
+              <div className="tabular mt-1.5 text-2xl font-semibold text-text">
+                {s.value}
+              </div>
+              <div className="mt-0.5 text-xs text-text-muted">{s.sub}</div>
+            </Card>
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+}
