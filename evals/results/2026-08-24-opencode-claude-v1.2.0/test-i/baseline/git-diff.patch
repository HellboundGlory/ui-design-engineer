@@ -0,0 +1,35 @@
+import { chromium } from "playwright";
+
+const base = "http://localhost:4173";
+const outDir = new URL("./screenshots/", import.meta.url);
+
+const viewports = [
+  { name: "desktop-1440", width: 1440, height: 900 },
+  { name: "tablet-834", width: 834, height: 1112 },
+  { name: "mobile-390", width: 390, height: 844 },
+];
+
+const browser = await chromium.launch();
+const page = await browser.newPage();
+
+let n = 1;
+for (const vp of viewports) {
+  await page.setViewportSize({ width: vp.width, height: vp.height });
+  await page.goto(`${base}/incidents`, { waitUntil: "networkidle" });
+  await page.screenshot({
+    path: new URL(`${String(n).padStart(2, "0")}-incidents-${vp.name}.png`, outDir).pathname,
+    fullPage: true,
+  });
+  n++;
+}
+
+// Also capture Dashboard for token-consistency sanity check
+await page.setViewportSize({ width: 1440, height: 900 });
+await page.goto(`${base}/`, { waitUntil: "networkidle" });
+await page.screenshot({
+  path: new URL(`${String(n).padStart(2, "0")}-dashboard-desktop-1440.png`, outDir).pathname,
+  fullPage: true,
+});
+
+await browser.close();
+console.log("done");
